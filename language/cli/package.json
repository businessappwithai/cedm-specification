{
  "name": "@appwithai/eml-cli",
  "version": "2.0.0",
  "type": "module",
  "description": "Validate a model (.eml.yaml) and build applications from it.",
  "bin": {
    "eml": "./eml.ts"
  },
  "scripts": {
    "start": "bun eml.ts",
    "validate:examples": "bun eml.ts validate -i ../yaml/examples/crm.eml.yaml",
    "typecheck": "tsc --noEmit",
    "lint": "biome check ."
  },
  "engines": {
    "bun": ">=1.4.0"
  },
  "devDependencies": {
    "@types/node": "22",
    "bun-types": "^1.4.0",
    "typescript": "5.6.3"
  }
}
