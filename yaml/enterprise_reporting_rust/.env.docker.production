# ==========================================
# Enterprise Reporting System
# Production Environment for Hostinger VPS
# ==========================================
# Copy this file to .env and update values:
#   cp .env.docker.production .env
#   nano .env
# ==========================================

APP_PORT=3000

# Redis Configuration
REDIS_PASSWORD=change-me-generate-a-strong-password
REDIS_PORT=6379

# Data storage path on VPS filesystem
DATA_PATH=/srv/enterprise-reporting-system

# Nginx / SSL Configuration
# No domain configured - using IP address only
DOMAIN=
SSL_EMAIL=

# Application
NEXT_PUBLIC_APP_URL=http://148.135.137.110
NODE_ENV=production

# Authentication
AUTH_SECRET=change-me-generate-with-openssl-rand-base64-48
AUTH_URL=http://148.135.137.110:3000

# Database (SQLite - Configuration Database)
DATABASE_PATH=./data/config.sqlite

# Redis (for BullMQ job queue)
REDIS_URL=redis://localhost:6379

# Encryption key for data source credentials (32 bytes hex)
ENCRYPTION_KEY=change-me-64-hex-characters-generate-with-openssl-rand-hex-32

# Job Processing
JOB_OUTPUT_PATH=./job-outputs
MAX_CONCURRENT_JOBS=5

# Error Reporting
NEXT_PUBLIC_ERROR_REPORTING_EMAIL=admin@yourcompany.com

# SERVER-SIDE PAGINATION CONFIGURATION (CRITICAL)
# IMPORTANT: This application uses SERVER-SIDE PAGINATION ONLY
# All data queries MUST include LIMIT and OFFSET at the database level
# DO NOT fetch all data and paginate on the client - this will overload the server

# Default page size for all paginated server queries
DEFAULT_PAGE_SIZE=50

# Maximum page size allowed (user cannot exceed this limit)
MAX_PAGE_SIZE=1000

# Default page size for data tables (server-side fetching)
DATA_TABLE_PAGE_SIZE=100

# Default page size for report exports (server-side batch processing)
EXPORT_PAGE_SIZE=1000

# Virtual scrolling threshold - when to enable virtual scrolling with server-side data fetching
VIRTUAL_SCROLL_THRESHOLD=500

# Enable virtual scrolling for large datasets (works with server-side pagination)
ENABLE_VIRTUAL_SCROLLING=true

# Natural Language Query (NL Query) - AI Configuration
# OpenAI API key for SQL generation and CopilotKit
OPENAI_API_KEY=
# Optional: Override model (default: gpt-4o)
OPENAI_MODEL=gpt-4o

# Optional: External Data Source Examples
# POSTGRES_URL=postgresql://user:password@localhost:5432/database
# MYSQL_URL=mysql://user:password@localhost:3306/database
