# The Rust backend reads the same variables as the Node service. Use the SAME
# values as the Node .env: AUTH_SECRET signs the session cookie both backends
# accept, and ENCRYPTION_KEY decrypts every stored data-source config.
AUTH_SECRET=
ENCRYPTION_KEY=
DATABASE_URL=postgresql://enterprise:password@localhost:5432/enterprise_config

# Sign-in (same as Node). BETTER_AUTH_URL (else APP_URL) is the origin trusted
# for cookie-bearing POSTs and decides whether cookies are __Secure-; CORS_ORIGIN
# and BETTER_AUTH_TRUSTED_ORIGINS add origins. BCRYPT_COST applies to new hashes.
BETTER_AUTH_URL=http://localhost:4050
CORS_ORIGIN=
BETTER_AUTH_TRUSTED_ORIGINS=
BCRYPT_COST=12

# Rust-only
PORT=5150
LOG_LEVEL=info
WORKER_CONCURRENCY=5
# Where report/export/email files are written. Make it ABSOLUTE when Node and
# Rust both run: each resolves a relative path against its own working
# directory, so one would not find the other's files.
JOB_OUTPUT_PATH=./job-outputs

# Scheduled NL reports (same as Node)
REPORT_ARTIFACT_RETENTION_DAYS=90
REPORT_ROW_LIMIT=
REPORT_QUERY_TIMEOUT_MS=
REPORT_EMAIL_MAX_ATTACHMENT_BYTES=
EXPORT_PAGE_SIZE=10000

# The knowledge graph (Apache AGE) that NL prompts draw table context from.
# Synced at start; unreachable, the graph context is simply left out.
GRAPH_DATABASE_URL=postgresql://enterprise:password@localhost:5432/ers_knowledge

# Models for NL query, the report builder and ADK (same as Node). MASTRA_URL
# is the Mastra server (supervisor, NL->SQL); the OpenAI-compatible reasoning
# server writes report definitions and classifies intents. AI_NL2SQL_BASE_URL
# (with /v1) overrides LLAMA_REASONING_URL (without).
MASTRA_URL=http://localhost:4111
MASTRA_API_KEY=
LLAMA_REASONING_URL=http://localhost:8080
LLAMA_REASONING_MODEL=
AI_NL2SQL_BASE_URL=
AI_NL2SQL_MODEL=

# Data sources on private addresses are refused unless listed here (comma-
# separated hostnames) or ALLOW_PRIVATE_DATA_SOURCES=1. A database on the
# Docker network needs its service name in the allowlist.
DATA_SOURCE_HOST_ALLOWLIST=
ALLOW_PRIVATE_DATA_SOURCES=

# Embeddings and speech for NL query (same as Node). Unset or unreachable, RAG
# falls back to hash embeddings and the voice routes answer "unavailable".
LLAMA_EMBEDDING_URL=http://localhost:8080
AI_EMBEDDING_BASE_URL=
LLAMA_STT_URL=http://localhost:8081
LLAMA_TTS_URL=http://localhost:8083

# Email alerts (same as Node)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=
