{
  "name": "enterprise-reporting-system",
  "version": "1.0.0",
  "type": "module",
  "description": "Enterprise Reporting and Dashboard System with TanStack Start + TanStack DB + shadcn/ui",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "start": "bun dist/server/server.js",
    "lint": "biome lint src",
    "lint:fix": "biome lint src --write",
    "format": "biome format src --write",
    "format:check": "biome format src",
    "setup": "bun scripts/setup.ts",
    "db:migrate": "bun scripts/rebuild-db.ts",
    "db:seed": "bun src/lib/db/seeds/001_initial_data.ts",
    "db:setup": "bun scripts/rebuild-db.ts && bun src/lib/db/seeds/001_initial_data.ts",
    "db:rollback": "echo 'Use scripts/rebuild-db.ts to reset the database'",
    "db:sample": "bun src/lib/db/sample-data/seed.ts",
    "jobs:worker": "bun src/lib/jobs/worker-runner.ts",
    "typecheck": "tsc --noEmit",
    "test:setup": "bun tests/setup-data.ts",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:all": "bun run test:setup && bun run test:e2e",
    "precommit": "bun run lint && bun run typecheck && bun run format:check",
    "build:check": "bun run lint && bun run typecheck && bun run build"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.29",
