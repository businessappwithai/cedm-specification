#[utoipa::path(
    get, path = "/api/accounts", tag = "accounts",
    security(("bearer" = [])),
    responses(
        (status = 200, description = "`{ data: [account] }` — every account, with its roles, newest login state and whether it can sign in"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
    ),
)]
pub async fn list(
    auth: auth::JWTWithUser<users::Model>,
    State(ctx): State<AppContext>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;

    let rows: Vec<(Value,)> = sqlx::query_as(AssertSqlSafe(format!(
        "SELECT {ACCOUNT_JSON} FROM sys_user su ORDER BY lower(su.email)"
    )))
    .fetch_all(pool)
    .await?;
    let data: Vec<Value> = rows.into_iter().map(|(account,)| account).collect();
    Ok(Json(json!({ "data": data, "meta": { "total": data.len() } })).into_response())
}

#[utoipa::path(
    get, path = "/api/accounts/{id}", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_user_id`")),
    responses(
        (status = 200, description = "The account"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such account"),
    ),
)]
pub async fn get_one(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "account")?;
    let mut conn = pool.acquire().await?;
    Ok(Json(account_json(&mut conn, id).await?).into_response())
}

#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct CreateAccount {
    pub email: String,
    pub name: String,
    pub password: String,
    #[serde(default)]
    pub description: Option<String>,
    #[serde(default)]
    pub roles: Vec<Uuid>,
    #[serde(default)]
    pub is_active: Option<bool>,
}

#[utoipa::path(
    post, path = "/api/accounts", tag = "accounts",
    security(("bearer" = [])),
    request_body(content = serde_json::Value, description = "`{ email, name, password, description?, roles?: [roleId], isActive? }`"),
    responses(
        (status = 201, description = "The account, able to sign in at once"),
        (status = 400, description = "Invalid payload, or a role that does not exist"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 409, description = "That email is already in use"),
    ),
)]
pub async fn create(
    auth: auth::JWTWithUser<users::Model>,
    State(ctx): State<AppContext>,
    Json(body): Json<CreateAccount>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;

    let email = body.email.trim().to_lowercase();
    let name = body.name.trim().to_string();
    let mut errors = Vec::new();
    check_email(&email, &mut errors);
    check_password(&body.password, &mut errors);
    if name.is_empty() {
        errors.push("name is required".to_string());
    }
    invalid(errors)?;

    let hashed = loco_rs::hash::hash_password(&body.password)
        .map_err(|err| AppError::Internal(anyhow::anyhow!("hashing a password: {err}")))?;
    let actor = actor(&auth.user);

    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    check_roles(&mut txn, &body.roles).await?;
    if email_taken(&mut txn, &email, None).await? {
        return Err(email_conflict());
    }

    let (sys_user_id,): (Uuid,) = sqlx::query_as(
        r"INSERT INTO sys_user (
               sys_user_id, name, email, password_hash, description,
               is_system_user, is_sales_rep, login_failure_count, is_locked,
               is_account_verified, entity_type, is_active,
               created_by, updated_by, created_at, updated_at)
           VALUES (gen_random_uuid(), $1, $2, $3, $4,
                   FALSE, FALSE, 0, FALSE,
                   TRUE, 'U', $5,
                   $6, $6, NOW(), NOW())
           RETURNING sys_user_id",
    )
    .bind(&name)
    .bind(&email)
    .bind(SYS_USER_PASSWORD_DISABLED)
    .bind(body.description.as_deref())
    .bind(body.is_active.unwrap_or(true))
    .bind(&actor)
    .fetch_one(&mut *txn)
    .await?;

    sqlx::query(
        r"INSERT INTO users (pid, email, password, api_key, name, sys_user_id)
           VALUES (gen_random_uuid(), $1, $2, $3, $4, $5)",
    )
    .bind(&email)
    .bind(&hashed)
    .bind(format!("lo-{}", Uuid::new_v4()))
    .bind(&name)
    .bind(sys_user_id)
    .execute(&mut *txn)
    .await?;

    set_roles(&mut txn, sys_user_id, &body.roles, &actor).await?;
    let account = account_json(&mut txn, sys_user_id).await?;
    txn.commit().await?;

    Ok((StatusCode::CREATED, Json(account)).into_response())
}

#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct UpdateAccount {
    #[serde(default)]
    pub email: Option<String>,
    #[serde(default)]
    pub name: Option<String>,
    /// `null` clears it; absent leaves it.
    #[serde(default, deserialize_with = "present")]
    pub description: Option<Option<String>>,
    #[serde(default)]
    pub is_active: Option<bool>,
    #[serde(default)]
    pub is_locked: Option<bool>,
    /// The complete set of roles the account should hold. Absent leaves them.
    #[serde(default)]
    pub roles: Option<Vec<Uuid>>,
}

#[utoipa::path(
    put, path = "/api/accounts/{id}", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_user_id`")),
    request_body(content = serde_json::Value, description = "Any of `{ email, name, description, isActive, isLocked, roles: [roleId] }`; `roles` replaces the set. Unlocking also clears the failure count"),
    responses(
        (status = 200, description = "The account as it now stands"),
        (status = 400, description = "Invalid payload, a role that does not exist, or suspending your own account"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such account"),
        (status = 409, description = "That email is in use, or the change would leave no active administrator"),
    ),
)]
pub async fn update(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
    Json(body): Json<UpdateAccount>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    let principal = require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "account")?;

    if body.is_active == Some(false) {
        refuse_self(&principal, id, "deactivate")?;
    }
    if body.is_locked == Some(true) {
        refuse_self(&principal, id, "lock")?;
    }

    let email = body.email.as_deref().map(|e| e.trim().to_lowercase());
    let name = body.name.as_deref().map(|n| n.trim().to_string());
    let mut errors = Vec::new();
    if let Some(email) = &email {
        check_email(email, &mut errors);
    }
    if name.as_deref() == Some("") {
        errors.push("name cannot be empty".to_string());
    }
    invalid(errors)?;

    let actor = actor(&auth.user);
    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    // 404 before anything is written.
    account_json(&mut txn, id).await?;

    if let Some(email) = &email {
        if email_taken(&mut txn, email, Some(id)).await? {
            return Err(email_conflict());
        }
    }
    if let Some(roles) = &body.roles {
        check_roles(&mut txn, roles).await?;
    }

    sqlx::query(
        r"UPDATE sys_user
             SET email               = COALESCE($2, email),
                 name                = COALESCE($3, name),
                 description         = CASE WHEN $4 THEN $5 ELSE description END,
                 is_active           = COALESCE($6, is_active),
                 is_locked           = COALESCE($7, is_locked),
                 login_failure_count = CASE WHEN $7 = false THEN 0 ELSE login_failure_count END,
                 updated_by          = $8,
                 updated_at          = NOW()
           WHERE sys_user_id = $1",
    )
    .bind(id)
    .bind(email.as_deref())
    .bind(name.as_deref())
    .bind(body.description.is_some())
    .bind(body.description.clone().flatten())
    .bind(body.is_active)
    .bind(body.is_locked)
    .bind(&actor)
    .execute(&mut *txn)
    .await?;

    // The credential row signs in by email, so it has to follow.
    sqlx::query(
        r"UPDATE users
             SET email = COALESCE($2, email),
                 name  = COALESCE($3, name),
                 updated_at = NOW()
           WHERE sys_user_id = $1",
    )
    .bind(id)
    .bind(email.as_deref())
    .bind(name.as_deref())
    .execute(&mut *txn)
    .await?;

    if let Some(roles) = &body.roles {
        set_roles(&mut txn, id, roles, &actor).await?;
    }

    authz::require_an_administrator(&mut txn).await?;
    let account = account_json(&mut txn, id).await?;
    txn.commit().await?;
    Ok(Json(account).into_response())
}

#[utoipa::path(
    post, path = "/api/accounts/{id}/deactivate", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_user_id`")),
    responses(
        (status = 200, description = "The account, now inactive: it cannot sign in, and any token it holds stops working"),
        (status = 400, description = "Deactivating your own account"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such account"),
        (status = 409, description = "It is the last active administrator"),
    ),
)]
pub async fn deactivate(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    let principal = require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "account")?;
    refuse_self(&principal, id, "deactivate")?;

    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    let updated = sqlx::query(
        "UPDATE sys_user SET is_active = FALSE, updated_by = $2, updated_at = NOW()
          WHERE sys_user_id = $1",
    )
    .bind(id)
    .bind(actor(&auth.user))
    .execute(&mut *txn)
    .await?;
    if updated.rows_affected() == 0 {
        return Err(AppError::NotFound(format!("account {id} not found")));
    }
    authz::require_an_administrator(&mut txn).await?;
    let account = account_json(&mut txn, id).await?;
    txn.commit().await?;
    Ok(Json(account).into_response())
}

#[derive(Debug, Deserialize)]
pub struct ResetPassword {
    pub password: String,
}

#[utoipa::path(
    post, path = "/api/accounts/{id}/reset-password", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_user_id`")),
    request_body(content = serde_json::Value, description = "`{ password }` — also unlocks the account and clears its failure count; gives a dictionary user with no login one"),
    responses(
        (status = 200, description = "The account"),
        (status = 400, description = "Password too short"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such account"),
    ),
)]
pub async fn reset_password(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
    Json(body): Json<ResetPassword>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "account")?;
    let mut errors = Vec::new();
    check_password(&body.password, &mut errors);
    invalid(errors)?;

    let hashed = loco_rs::hash::hash_password(&body.password)
        .map_err(|err| AppError::Internal(anyhow::anyhow!("hashing a password: {err}")))?;

    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    let found: Option<(String, String)> = sqlx::query_as(
        r"UPDATE sys_user
             SET is_locked = FALSE, login_failure_count = 0,
                 updated_by = $2, updated_at = NOW()
           WHERE sys_user_id = $1
       RETURNING email, name",
    )
    .bind(id)
    .bind(actor(&auth.user))
    .fetch_optional(&mut *txn)
    .await?;
    let Some((email, name)) = found else {
        return Err(AppError::NotFound(format!("account {id} not found")));
    };

    // A reset is how a dictionary user the seed described — one with no
    // credential row — is given a login, so the row is created if missing.
    let changed = sqlx::query("UPDATE users SET password = $2, updated_at = NOW() WHERE sys_user_id = $1")
        .bind(id)
        .bind(&hashed)
        .execute(&mut *txn)
        .await?;
    if changed.rows_affected() == 0 {
        if email_taken(&mut txn, &email.to_lowercase(), Some(id)).await? {
            return Err(email_conflict());
        }
        sqlx::query(
            r"INSERT INTO users (pid, email, password, api_key, name, sys_user_id)
               VALUES (gen_random_uuid(), $1, $2, $3, $4, $5)",
        )
        .bind(email.to_lowercase())
        .bind(&hashed)
        .bind(format!("lo-{}", Uuid::new_v4()))
        .bind(&name)
        .bind(id)
        .execute(&mut *txn)
        .await?;
    }

    let account = account_json(&mut txn, id).await?;
    txn.commit().await?;
    Ok(Json(account).into_response())
}

#[utoipa::path(
    delete, path = "/api/accounts/{id}", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_user_id`")),
    responses(
        (status = 204, description = "Deleted — the login and the dictionary user both"),
        (status = 400, description = "Deleting your own account"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such account"),
        (status = 409, description = "It is the last active administrator, or records still point at it — deactivate it instead"),
    ),
)]
pub async fn remove(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    let principal = require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "account")?;
    refuse_self(&principal, id, "delete")?;

    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    sqlx::query("DELETE FROM users WHERE sys_user_id = $1")
        .bind(id)
        .execute(&mut *txn)
        .await?;
    // `sys_user_roles` cascades. A foreign key from elsewhere that does not is
    // a 409 through `From<sqlx::Error>` — the account has history, and
    // deactivating it is the answer rather than deleting what points at it.
    let deleted = sqlx::query("DELETE FROM sys_user WHERE sys_user_id = $1")
        .bind(id)
        .execute(&mut *txn)
        .await?;
    if deleted.rows_affected() == 0 {
        return Err(AppError::NotFound(format!("account {id} not found")));
    }
    authz::require_an_administrator(&mut txn).await?;
    txn.commit().await?;
    Ok(StatusCode::NO_CONTENT.into_response())
}

