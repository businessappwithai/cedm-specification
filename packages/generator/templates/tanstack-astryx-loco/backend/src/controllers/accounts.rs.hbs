//! Accounts and roles: who may sign in, and what they hold.
//!
//! Generated: {{now}}
//! Project: {{project.name}}
//!
//! **Two rows make one account.** `users` is the credential store Loco's JWT
//! auth reads (decision D1), and `sys_user` is the Application Dictionary's
//! identity, which carries the roles every authorisation gate reads. The link is
//! `users.sys_user_id`. Before this controller the only ways to make the pair
//! were the `ensure_admin` and `seed_access` tasks, or `/api/auth/register`
//! followed by hand-written SQL to link the result — so an administrator could
//! see accounts in the running application and change none of them. Every write
//! here keeps the two rows in step inside one transaction.
//!
//! **Master role only, reads included.** The generic `/api/sys/users` read is
//! open because the dictionary is; this one is not, because it answers a
//! different question — who can sign in, whether they are locked, when they
//! last did — and that is an account register, not metadata.
//!
//! **Nobody can remove the last administrator.** Every write that can change
//! who administers the application runs under `authz::lock_accounts` and ends
//! with `authz::require_an_administrator`, asked of the state the transaction
//! would commit. It is checked after the write rather than predicted before it,
//! because the ways to lose the last administrator are more than anyone lists:
//! deactivate the account, lock it, delete it, revoke its role, or clear the
//! master flag on the role itself. The generic `/api/sys` writes to the same
//! three tables pass through the same check.
//!
//! **Active and Locked are enforced where they are read.** `/api/auth/login`
//! refuses both, and `users::Model::find_by_claims_key` refuses both on every
//! request that carries a token — so suspending an account here ends its
//! session on its next request rather than when its token expires.

use axum::{
    extract::{Path, State},
    http::StatusCode,
    response::{IntoResponse, Response},
    Json,
};
use loco_rs::prelude::*;
use serde::Deserialize;
use serde_json::{json, Value};
use sqlx::AssertSqlSafe;
use uuid::Uuid;

use crate::errors::{AppError, AppResult};
use crate::models::_entities::users;
use crate::services::authz;

/// `sys_user.password_hash` is NOT NULL but is not a credential: the password
/// lives in `users`, once. `!` is the `/etc/shadow` spelling of "no login
/// here", the same value `ensure_admin` and `seed_access` write.
const SYS_USER_PASSWORD_DISABLED: &str = "!";

/// The shortest password an administrator may set — the same bar
/// `/api/auth/register` and `/api/auth/change-password` hold.
const MIN_PASSWORD_LEN: usize = 8;

/// What `created_by` / `updated_by` record for a write made here.
fn actor(user: &users::Model) -> String {
    user.email.clone()
}

/// Every handler's first line: a master-role caller, or nothing.
async fn require_account_admin(
    pool: &sqlx::PgPool,
    user: &users::Model,
) -> AppResult<authz::Principal> {
    let principal = authz::principal(pool, user).await?;
    if principal.is_master {
        return Ok(principal);
    }
    Err(AppError::Forbidden(
        "managing accounts and roles requires the master role".to_string(),
    ))
}

/// One account as the screens read it.
///
/// Built in SQL so a list is one round trip, roles included. `hasLogin` is
/// false for a dictionary user with no credential row — one the model's seed
/// described but nobody gave a password — and is what the screen offers
/// "set a password" against.
const ACCOUNT_JSON: &str = r"
    json_build_object(
        'id',                su.sys_user_id,
        'email',             su.email,
        'name',              su.name,
        'description',       su.description,
        'isActive',          su.is_active,
        'isLocked',          su.is_locked,
        'isSystemUser',      su.is_system_user,
        'loginDate',         su.login_date,
        'loginFailureCount', su.login_failure_count,
        'hasLogin',          EXISTS (SELECT 1 FROM users u WHERE u.sys_user_id = su.sys_user_id),
        'isMaster',          EXISTS (
                                 SELECT 1
                                   FROM sys_user_roles ur
                                   JOIN sys_role r ON r.sys_role_id = ur.sys_role_id
                                  WHERE ur.sys_user_id = su.sys_user_id
                                    AND COALESCE(ur.is_active, true) = true
                                    AND COALESCE(r.is_master_role, false) = true),
        'roles',             COALESCE((
                                 SELECT json_agg(json_build_object(
                                            'id', r.sys_role_id,
                                            'name', r.name,
                                            'isMasterRole', r.is_master_role)
                                          ORDER BY r.name)
                                   FROM sys_user_roles ur
                                   JOIN sys_role r ON r.sys_role_id = ur.sys_role_id
                                  WHERE ur.sys_user_id = su.sys_user_id
                                    AND COALESCE(ur.is_active, true) = true), '[]'::json),
        'createdAt',         su.created_at,
        'updatedAt',         su.updated_at
    )";

/// One role as the screens read it, with how many accounts hold it.
const ROLE_JSON: &str = r"
    json_build_object(
        'id',           r.sys_role_id,
        'name',         r.name,
        'description',  r.description,
        'isMasterRole', r.is_master_role,
        'isActive',     r.is_active,
        'userCount',    (SELECT COUNT(*)
                           FROM sys_user_roles ur
                          WHERE ur.sys_role_id = r.sys_role_id
                            AND COALESCE(ur.is_active, true) = true),
        'createdAt',    r.created_at,
        'updatedAt',    r.updated_at
    )";

async fn account_json(conn: &mut sqlx::PgConnection, id: Uuid) -> AppResult<Value> {
    let row: Option<(Value,)> = sqlx::query_as(AssertSqlSafe(format!(
        "SELECT {ACCOUNT_JSON} FROM sys_user su WHERE su.sys_user_id = $1"
    )))
    .bind(id)
    .fetch_optional(conn)
    .await?;
    row.map(|(account,)| account)
        .ok_or_else(|| AppError::NotFound(format!("account {id} not found")))
}

async fn role_json(conn: &mut sqlx::PgConnection, id: Uuid) -> AppResult<Value> {
    let row: Option<(Value,)> = sqlx::query_as(AssertSqlSafe(format!(
        "SELECT {ROLE_JSON} FROM sys_role r WHERE r.sys_role_id = $1"
    )))
    .bind(id)
    .fetch_optional(conn)
    .await?;
    row.map(|(role,)| role)
        .ok_or_else(|| AppError::NotFound(format!("role {id} not found")))
}

/// Tell "absent" from "null": `description: null` clears the column, while a
/// body that leaves `description` out leaves it alone.
fn present<'de, D>(deserializer: D) -> Result<Option<Option<String>>, D::Error>
where
    D: serde::Deserializer<'de>,
{
    Option::<String>::deserialize(deserializer).map(Some)
}

fn parse_id(id: &str, what: &str) -> AppResult<Uuid> {
    Uuid::parse_str(id).map_err(|_| AppError::NotFound(format!("{what} {id} not found")))
}

fn invalid(errors: Vec<String>) -> AppResult<()> {
    if errors.is_empty() {
        return Ok(());
    }
    Err(AppError::Validation {
        message: "Validation failed".to_string(),
        errors,
    })
}

fn check_email(email: &str, errors: &mut Vec<String>) {
    let email = email.trim();
    if email.is_empty() || !email.contains('@') {
        errors.push("email must be a valid address".to_string());
    }
}

fn check_password(password: &str, errors: &mut Vec<String>) {
    if password.chars().count() < MIN_PASSWORD_LEN {
        errors.push(format!("password must be at least {MIN_PASSWORD_LEN} characters"));
    }
}

/// An administrator may not suspend or delete the account they are using.
///
/// The last-administrator guard already stops the case that cannot be undone;
/// this stops the one that is merely confusing — the screen that answers
/// "saved" and then signs its own user out.
fn refuse_self(principal: &authz::Principal, id: Uuid, what: &str) -> AppResult<()> {
    if principal.sys_user_id == Some(id) {
        return Err(AppError::BadRequest(format!(
            "You cannot {what} your own account."
        )));
    }
    Ok(())
}

/// Every role id named exists. Unknown ids are a 400 naming them, not a
/// foreign-key 409 naming nothing.
async fn check_roles(conn: &mut sqlx::PgConnection, roles: &[Uuid]) -> AppResult<()> {
    if roles.is_empty() {
        return Ok(());
    }
    let known: Vec<Uuid> =
        sqlx::query_scalar("SELECT sys_role_id FROM sys_role WHERE sys_role_id = ANY($1)")
            .bind(roles)
            .fetch_all(conn)
            .await?;
    let missing: Vec<String> = roles
        .iter()
        .filter(|id| !known.contains(id))
        .map(|id| format!("no role with id {id}"))
        .collect();
    invalid(missing)
}

/// Make the account hold exactly `roles`, and make the first its default.
async fn set_roles(
    conn: &mut sqlx::PgConnection,
    sys_user_id: Uuid,
    roles: &[Uuid],
    actor: &str,
) -> AppResult<()> {
    sqlx::query("DELETE FROM sys_user_roles WHERE sys_user_id = $1 AND NOT (sys_role_id = ANY($2))")
        .bind(sys_user_id)
        .bind(roles)
        .execute(&mut *conn)
        .await?;
    for role in roles {
        // A grant that exists but was deactivated is a grant the administrator
        // just asked for again, so it is switched back on rather than skipped.
        sqlx::query(
            r"INSERT INTO sys_user_roles (
                   sys_user_roles_id, sys_user_id, sys_role_id,
                   entity_type, is_active, created_by, updated_by, created_at, updated_at)
               VALUES (gen_random_uuid(), $1, $2, 'U', TRUE, $3, $3, NOW(), NOW())
               ON CONFLICT (sys_user_id, sys_role_id) DO UPDATE
                   SET is_active = TRUE, updated_by = EXCLUDED.updated_by, updated_at = NOW()",
        )
        .bind(sys_user_id)
        .bind(role)
        .bind(actor)
        .execute(&mut *conn)
        .await?;
    }
    sqlx::query("UPDATE sys_user SET default_sys_role_id = $2 WHERE sys_user_id = $1")
        .bind(sys_user_id)
        .bind(roles.first())
        .execute(&mut *conn)
        .await?;
    Ok(())
}

/// Is this address taken by another account, in either half of the pair?
async fn email_taken(
    conn: &mut sqlx::PgConnection,
    email: &str,
    except: Option<Uuid>,
) -> AppResult<bool> {
    let (taken,): (bool,) = sqlx::query_as(
        r"SELECT EXISTS (SELECT 1 FROM sys_user
                          WHERE lower(email) = $1
                            AND sys_user_id IS DISTINCT FROM $2)
              OR EXISTS (SELECT 1 FROM users
                          WHERE lower(email) = $1
                            AND sys_user_id IS DISTINCT FROM $2)",
    )
    .bind(email)
    .bind(except)
    .fetch_one(conn)
    .await?;
    Ok(taken)
}

fn email_conflict() -> AppError {
    AppError::Conflict("An account with that email already exists".to_string())
}

