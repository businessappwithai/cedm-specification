#[utoipa::path(
    get, path = "/api/accounts/roles", tag = "accounts",
    security(("bearer" = [])),
    responses(
        (status = 200, description = "`{ data: [role] }` — every role, with how many accounts hold it"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
    ),
)]
pub async fn list_roles(
    auth: auth::JWTWithUser<users::Model>,
    State(ctx): State<AppContext>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;
    let rows: Vec<(Value,)> = sqlx::query_as(AssertSqlSafe(format!(
        "SELECT {ROLE_JSON} FROM sys_role r ORDER BY r.name"
    )))
    .fetch_all(pool)
    .await?;
    let data: Vec<Value> = rows.into_iter().map(|(role,)| role).collect();
    Ok(Json(json!({ "data": data, "meta": { "total": data.len() } })).into_response())
}

#[derive(Debug, Deserialize)]
#[serde(rename_all = "camelCase")]
pub struct RoleBody {
    #[serde(default)]
    pub name: Option<String>,
    #[serde(default, deserialize_with = "present")]
    pub description: Option<Option<String>>,
    #[serde(default)]
    pub is_master_role: Option<bool>,
    #[serde(default)]
    pub is_active: Option<bool>,
}

#[utoipa::path(
    post, path = "/api/accounts/roles", tag = "accounts",
    security(("bearer" = [])),
    request_body(content = serde_json::Value, description = "`{ name, description?, isMasterRole?, isActive? }`"),
    responses(
        (status = 201, description = "The role. It reaches no window until it is granted one"),
        (status = 400, description = "No name"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 409, description = "A role with that name exists"),
    ),
)]
pub async fn create_role(
    auth: auth::JWTWithUser<users::Model>,
    State(ctx): State<AppContext>,
    Json(body): Json<RoleBody>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;
    let name = body.name.as_deref().map(str::trim).unwrap_or_default().to_string();
    if name.is_empty() {
        invalid(vec!["name is required".to_string()])?;
    }

    let mut txn = pool.begin().await?;
    let (taken,): (bool,) =
        sqlx::query_as("SELECT EXISTS (SELECT 1 FROM sys_role WHERE lower(name) = lower($1))")
            .bind(&name)
            .fetch_one(&mut *txn)
            .await?;
    if taken {
        return Err(AppError::Conflict("A role with that name already exists".to_string()));
    }
    let (role_id,): (Uuid,) = sqlx::query_as(
        r"INSERT INTO sys_role (
               sys_role_id, name, description, user_level, is_master_role,
               is_can_export, is_can_report, is_personal_lock, is_personal_access,
               max_query_records, is_show_accounting,
               entity_type, is_active, created_by, updated_by, created_at, updated_at)
           VALUES (gen_random_uuid(), $1, $2, 'U', $3,
                   TRUE, TRUE, FALSE, FALSE, 0, FALSE,
                   'U', $4, $5, $5, NOW(), NOW())
           RETURNING sys_role_id",
    )
    .bind(&name)
    .bind(body.description.clone().flatten())
    .bind(body.is_master_role.unwrap_or(false))
    .bind(body.is_active.unwrap_or(true))
    .bind(actor(&auth.user))
    .fetch_one(&mut *txn)
    .await?;
    let role = role_json(&mut txn, role_id).await?;
    txn.commit().await?;
    Ok((StatusCode::CREATED, Json(role)).into_response())
}

#[utoipa::path(
    put, path = "/api/accounts/roles/{id}", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_role_id`")),
    request_body(content = serde_json::Value, description = "Any of `{ name, description, isMasterRole, isActive }`. Renaming a role detaches it from access rules written against the old name"),
    responses(
        (status = 200, description = "The role as it now stands"),
        (status = 400, description = "Empty name"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such role"),
        (status = 409, description = "The name is taken, or the change would leave no active administrator"),
    ),
)]
pub async fn update_role(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
    Json(body): Json<RoleBody>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "role")?;
    let name = body.name.as_deref().map(|n| n.trim().to_string());
    if name.as_deref() == Some("") {
        invalid(vec!["name cannot be empty".to_string()])?;
    }

    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    role_json(&mut txn, id).await?;
    if let Some(name) = &name {
        let (taken,): (bool,) = sqlx::query_as(
            "SELECT EXISTS (SELECT 1 FROM sys_role WHERE lower(name) = lower($1) AND sys_role_id <> $2)",
        )
        .bind(name)
        .bind(id)
        .fetch_one(&mut *txn)
        .await?;
        if taken {
            return Err(AppError::Conflict("A role with that name already exists".to_string()));
        }
    }
    sqlx::query(
        r"UPDATE sys_role
             SET name           = COALESCE($2, name),
                 description    = CASE WHEN $3 THEN $4 ELSE description END,
                 is_master_role = COALESCE($5, is_master_role),
                 is_active      = COALESCE($6, is_active),
                 updated_by     = $7,
                 updated_at     = NOW()
           WHERE sys_role_id = $1",
    )
    .bind(id)
    .bind(name.as_deref())
    .bind(body.description.is_some())
    .bind(body.description.clone().flatten())
    .bind(body.is_master_role)
    .bind(body.is_active)
    .bind(actor(&auth.user))
    .execute(&mut *txn)
    .await?;
    authz::require_an_administrator(&mut txn).await?;
    let role = role_json(&mut txn, id).await?;
    txn.commit().await?;
    Ok(Json(role).into_response())
}

#[utoipa::path(
    delete, path = "/api/accounts/roles/{id}", tag = "accounts",
    security(("bearer" = [])),
    params(("id" = String, Path, description = "`sys_role_id`")),
    responses(
        (status = 204, description = "Deleted, with every grant of it"),
        (status = 401, description = "No token"),
        (status = 403, description = "Requires the master role"),
        (status = 404, description = "No such role"),
        (status = 409, description = "The change would leave no active administrator"),
    ),
)]
pub async fn remove_role(
    auth: auth::JWTWithUser<users::Model>,
    Path(id): Path<String>,
    State(ctx): State<AppContext>,
) -> AppResult<Response> {
    let pool = ctx.db.get_postgres_connection_pool();
    require_account_admin(pool, &auth.user).await?;
    let id = parse_id(&id, "role")?;

    let mut txn = pool.begin().await?;
    authz::lock_accounts(&mut txn).await?;
    // `default_sys_role_id` is ON DELETE SET NULL and the grants cascade, so
    // the role leaves nothing dangling behind it.
    let deleted = sqlx::query("DELETE FROM sys_role WHERE sys_role_id = $1")
        .bind(id)
        .execute(&mut *txn)
        .await?;
    if deleted.rows_affected() == 0 {
        return Err(AppError::NotFound(format!("role {id} not found")));
    }
    authz::require_an_administrator(&mut txn).await?;
    txn.commit().await?;
    Ok(StatusCode::NO_CONTENT.into_response())
}

pub fn routes() -> Routes {
    Routes::new()
        .prefix("accounts")
        .add("/", get(list))
        .add("/", post(create))
        // Static before parameter at the same depth: matchit prefers `/roles`
        // over `/{id}`, so the role routes are reachable.
        .add("/roles", get(list_roles))
        .add("/roles", post(create_role))
        .add("/roles/{id}", put(update_role))
        .add("/roles/{id}", delete(remove_role))
        .add("/{id}", get(get_one))
        .add("/{id}", put(update))
        .add("/{id}", delete(remove))
        .add("/{id}/deactivate", post(deactivate))
        .add("/{id}/reset-password", post(reset_password))
}
