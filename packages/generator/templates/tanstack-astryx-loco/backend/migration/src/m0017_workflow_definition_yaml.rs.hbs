//! `sys_workflow_definitions.definition_yaml` — automations stored as YAML, once
//! and for all.
//!
//! Automations used to be stored as mermaid with `%%` directives in
//! `mermaid_code`. This migration converts every such row to the automation's
//! YAML document and then drops the column, so nothing in the application reads
//! mermaid again. The conversion is the automations screen's former reader,
//! `parseAutomation`, ported line for line: a row reads back as exactly the
//! automation the screen used to open. It lives here, and only here, because it
//! is needed exactly once per database.
//!
//! The document is written as JSON, which is YAML: the screen reads it with its
//! YAML reader, and the first save rewrites it in the screen's own layout.

use sea_orm_migration::prelude::*;
use sea_orm_migration::sea_orm::entity::prelude::Json;
use sea_orm_migration::sea_orm::{ConnectionTrait, DbBackend, Statement};

#[derive(DeriveMigrationName)]
pub struct Migration;

#[async_trait::async_trait]
impl MigrationTrait for Migration {
    async fn up(&self, manager: &SchemaManager) -> Result<(), DbErr> {
        let db = manager.get_connection();
        db.execute_unprepared(include_str!("../sql/m0017_workflow_definition_yaml.up.sql"))
            .await?;

        // A database created after m0013 was rewritten has no `mermaid_code`
        // column to read from, and nothing to convert.
        let has_mermaid = db
            .query_one_raw(Statement::from_string(
                DbBackend::Postgres,
                "SELECT 1 AS present FROM information_schema.columns \
                 WHERE table_name = 'sys_workflow_definitions' AND column_name = 'mermaid_code'",
            ))
            .await?
            .is_some();
        if has_mermaid {
            let rows = db
                .query_all_raw(Statement::from_string(
                    DbBackend::Postgres,
                    "SELECT id::text AS id, name, entity_name, mermaid_code \
                     FROM sys_workflow_definitions \
                     WHERE kind = 'automation' AND definition_yaml IS NULL \
                       AND mermaid_code IS NOT NULL",
                ))
                .await?;
            for row in rows {
                let id: String = row.try_get("", "id")?;
                let name: String = row.try_get("", "name")?;
                let entity: String = row.try_get("", "entity_name")?;
                let mermaid: String = row.try_get("", "mermaid_code")?;
                let document = automation_document(&mermaid, &entity, &name);
                db.execute_raw(Statement::from_sql_and_values(
                    DbBackend::Postgres,
                    "UPDATE sys_workflow_definitions SET definition_yaml = $1 WHERE id::text = $2",
                    [document.to_string().into(), id.into()],
                ))
                .await?;
            }
        }

        db.execute_unprepared(include_str!("../sql/m0017_workflow_definition_yaml.finish.sql"))
            .await?;
        Ok(())
    }

    async fn down(&self, manager: &SchemaManager) -> Result<(), DbErr> {
        manager
            .get_connection()
            .execute_unprepared(include_str!("../sql/m0017_workflow_definition_yaml.down.sql"))
            .await?;
        Ok(())
    }
}

/* -------------------------------------------------------------------------- */
/*  The former automation reader                                               */
/* -------------------------------------------------------------------------- */

/// The step types the automations screen builds.
const STEP_TYPES: [&str; 6] = [
    "UpdateEntity",
    "CreateEntity",
    "DeleteEntity",
    "Decision",
    "Formula",
    "REST",
];

const OPEN: &str = concat!("{", "{");
const CLOSE: &str = concat!("}", "}");

/// A reference to a value an earlier step published, as the screen writes one.
fn reference(name: &str) -> String {
    format!("{OPEN}{name}{CLOSE}")
}

fn hook_event(hook: &str) -> Option<&'static str> {
    Some(match hook {
        "afterCreate" => "created",
        "beforeCreate" => "beforeCreated",
        "afterUpdate" => "updated",
        "beforeUpdate" => "beforeUpdated",
        "afterDelete" => "deleted",
        "beforeDelete" => "beforeDeleted",
        _ => return None,
    })
}

fn saga_operation_event(operation: &str) -> &'static str {
    match operation {
        "UPDATE" => "updated",
        "DELETE" => "deleted",
        _ => "created",
    }
}

#[derive(Default)]
struct Step {
    id: String,
    step_type: String,
    result_name: String,
    props: Vec<(String, String)>,
    loop_id: Option<String>,
    table: Option<Json>,
}

impl Step {
    fn set(&mut self, key: &str, value: String) {
        match self.props.iter_mut().find(|(existing, _)| existing == key) {
            Some(slot) => slot.1 = value,
            None => self.props.push((key.to_string(), value)),
        }
    }

    fn set_if_absent(&mut self, key: &str, value: String) {
        if !self.props.iter().any(|(existing, _)| existing == key) {
            self.props.push((key.to_string(), value));
        }
    }
}

struct Condition {
    field: String,
    operator: String,
    value: String,
}

struct Loop {
    id: String,
    condition: Condition,
    max_passes: String,
}

struct Hook {
    event: String,
    handler: String,
    field: Option<String>,
}

/// The first whitespace-separated word of `text`, and the rest trimmed.
fn word(text: &str) -> Option<(&str, &str)> {
    let text = text.trim_start();
    if text.is_empty() {
        return None;
    }
    let end = text.find(char::is_whitespace).unwrap_or(text.len());
    Some((&text[..end], text[end..].trim_start()))
}

fn is_identifier(text: &str) -> bool {
    let mut chars = text.chars();
    chars
        .next()
        .is_some_and(|c| c.is_ascii_alphabetic() || c == '_')
        && chars.all(|c| c.is_ascii_alphanumeric() || c == '_')
}

/// A stored value: JSON text when it opens with a quote, as the screen wrote a
/// string; otherwise the text as it stands.
fn stored_value(raw: &str) -> String {
    let raw = raw.trim();
    if raw.starts_with('"') {
        if let Ok(Json::String(text)) = raw.parse::<Json>() {
            return text;
        }
    }
    raw.to_string()
}

/// `key: value` pairs where a value runs to the next ` key:` token, so it may
/// contain spaces — a title, a URL, a JSON document.
fn saga_props(rest: &str) -> Vec<(String, String)> {
    let rest = rest.trim();
    let mut starts = vec![0];
    let bytes = rest.as_bytes();
    for index in 1..bytes.len() {
        if bytes[index - 1].is_ascii_whitespace() {
            let tail = &rest[index..];
            let key_len = tail
                .find(|c: char| !(c.is_ascii_alphanumeric() || c == '_'))
                .unwrap_or(tail.len());
            if key_len > 0
                && is_identifier(&tail[..key_len])
                && tail[key_len..].starts_with(':')
            {
                starts.push(index);
            }
        }
    }
    starts.push(rest.len());
    let mut props = Vec::new();
    for pair in starts.windows(2) {
        let part = rest[pair[0]..pair[1]].trim();
        if let Some((key, value)) = part.split_once(':') {
            if is_identifier(key) {
                props.push((key.to_string(), value.trim().to_string()));
            }
        }
    }
    props
}

fn take(props: &mut Vec<(String, String)>, key: &str) -> Option<String> {
    let index = props.iter().position(|(existing, _)| existing == key)?;
    Some(props.remove(index).1)
}

/// Translate a saga step's property names into the automation screen's.
fn apply_saga_props(step: &mut Step, mut props: Vec<(String, String)>) {
    if let Some(name) = take(&mut props, "as").filter(|v| !v.is_empty()) {
        step.result_name = name;
    }
    match step.step_type.as_str() {
        "Decision" => {
            if let Some(table) = take(&mut props, "decisionTable") {
                if let Ok(parsed) = table.parse::<Json>() {
                    step.table = Some(parsed);
                }
            }
        }
        "Formula" => {
            let target = take(&mut props, "target");
            if let Some(target) = target.filter(|v| !v.is_empty()) {
                if step.result_name.is_empty() {
                    step.result_name = target;
                }
            }
            let source = take(&mut props, "source");
            let value = take(&mut props, "value");
            match (source.filter(|v| !v.is_empty()), value) {
                (Some(source), _) => step.set("left", reference(&source)),
                (None, Some(value)) => step.set("left", value),
                (None, None) => {}
            }
            if let Some(operand) = take(&mut props, "operand") {
                step.set("right", operand);
            }
        }
        "CreateEntity" => {
            if let Some(fields) = take(&mut props, "fields") {
                step.set("values", fields);
            }
        }
        "UpdateEntity" => {
            if let Some(source) = take(&mut props, "source").filter(|v| !v.is_empty()) {
                step.set("value", reference(&source));
            }
            if let Some(target) = take(&mut props, "targetSource").filter(|v| !v.is_empty()) {
                step.set("target", reference(&target));
            }
        }
        "DeleteEntity" => {
            let target_source = take(&mut props, "targetSource").filter(|v| !v.is_empty());
            let target_field = take(&mut props, "targetField").filter(|v| !v.is_empty());
            if let Some(source) = target_source {
                step.set("target", reference(&source));
            } else if let Some(field) = target_field {
                step.set("target", field);
            }
        }
        "REST" => {
            if let Some(body) = take(&mut props, "bodyTemplate") {
                step.set("body", body);
            }
        }
        _ => {}
    }
    for (key, value) in props {
        if !value.is_empty() {
            step.set_if_absent(&key, value);
        }
    }
}

/// Read a stored automation's mermaid into its YAML document.
///
/// Anything the directives do not describe is dropped rather than guessed at,
/// exactly as the screen's reader did — a half-understood automation that
/// silently gained a step would be worse than one that opens with the steps it
/// could actually read.
pub(crate) fn automation_document(source: &str, fallback_entity: &str, name: &str) -> Json {
    let mut kind = "automation";
    let mut entity = fallback_entity.to_string();
    let mut event = "created".to_string();
    let mut saga: Option<(&'static str, &'static str)> = None;
    let mut conditions: Vec<Condition> = Vec::new();
    let mut loops: Vec<Loop> = Vec::new();
    let mut hooks: Vec<Hook> = Vec::new();
    let mut steps: Vec<(String, Step)> = Vec::new();

    for raw in source.lines() {
        let line = raw.trim();

        if let Some(rest) = line.strip_prefix("%%workflow") {
            let rest = rest.trim_start();
            if rest.starts_with("name:") {
                continue; // the row's own name is the one that counts
            }
            let Some((_, after_name)) = word(rest) else { continue };
            let Some(after_entity) = after_name.strip_prefix("entity:") else { continue };
            let Some((workflow_entity, settings)) = word(after_entity) else { continue };
            if !is_identifier(workflow_entity) {
                continue;
            }
            let setting = |key: &str| -> Option<String> {
                let at = settings.find(key)?;
                word(&settings[at + key.len()..]).map(|(value, _)| {
                    value.trim_end_matches(|c: char| !c.is_ascii_alphanumeric() && c != '_').to_string()
                })
            };
            let operation = setting("operation:").map(|op| op.to_ascii_uppercase());
            entity = workflow_entity.to_string();
            event = saga_operation_event(operation.as_deref().unwrap_or("")).to_string();
            if setting("kind:").as_deref() == Some("saga") {
                kind = "saga";
                let trigger = if setting("trigger:").as_deref() == Some("rule") {
                    "rule"
                } else {
                    "automatic"
                };
                let operation = match operation.as_deref() {
                    Some("UPDATE") => "UPDATE",
                    Some("DELETE") => "DELETE",
                    Some("ALL") => "ALL",
                    _ => "CREATE",
                };
                saga = Some((trigger, operation));
            }
            continue;
        }

        if let Some(rest) = line.strip_prefix("%%hook") {
            let Some((hook, rest)) = word(rest) else { continue };
            let Some((second, rest)) = word(rest) else { continue };
            if second == "on" {
                let Some((hook_entity, _)) = word(rest) else { continue };
                entity = hook_entity.to_string();
                event = hook_event(hook).unwrap_or("created").to_string();
            } else if let Some(rest) = rest.strip_prefix("on") {
                let target = rest.trim_start();
                let (hook_entity, bracket) = match target.find('[') {
                    Some(at) => (&target[..at], Some(&target[at..])),
                    None => (target.split_whitespace().next().unwrap_or(""), None),
                };
                let field = bracket
                    .and_then(|b| b.trim_start_matches('[').split(']').next())
                    .and_then(|inner| inner.trim().strip_prefix("field:"))
                    .map(|f| f.trim().to_string())
                    .filter(|f| !f.is_empty());
                kind = "hook";
                entity = hook_entity.trim().to_string();
                hooks.push(Hook {
                    event: hook.to_string(),
                    handler: second.to_string(),
                    field,
                });
            }
            continue;
        }

        if let Some(rest) = line.strip_prefix("%%loop") {
            let Some((loop_id, rest)) = word(rest) else { continue };
            let Some(rest) = rest.strip_prefix("while:") else { continue };
            let Some((field, rest)) = word(rest) else { continue };
            let Some((operator, rest)) = word(rest) else { continue };
            let mut rest = rest.trim().to_string();
            let mut max_passes = String::new();
            if let Some(at) = rest.rfind("max:") {
                let tail = rest[at + 4..].trim();
                if !tail.is_empty() && !tail.contains(char::is_whitespace) {
                    max_passes = tail.to_string();
                    rest.truncate(at);
                }
            }
            loops.push(Loop {
                id: loop_id.to_string(),
                condition: Condition {
                    field: field.to_string(),
                    operator: operator.to_string(),
                    value: stored_value(&rest),
                },
                max_passes,
            });
            continue;
        }

        if let Some(rest) = line.strip_prefix("%%guard") {
            let Some((field, rest)) = word(rest) else { continue };
            let Some((operator, rest)) = word(rest) else { continue };
            // The old spelling of an access rule, not a condition.
            if field.starts_with("role:") && operator == "on" {
                continue;
            }
            conditions.push(Condition {
                field: field.to_string(),
                operator: operator.to_string(),
                value: stored_value(rest),
            });
            continue;
        }

        if let Some(rest) = line.strip_prefix("%%step") {
            let Some((node, rest)) = word(rest) else { continue };
            let index = match steps.iter().position(|(id, _)| id == node) {
                Some(index) => index,
                None => {
                    steps.push((
                        node.to_string(),
                        Step {
                            id: format!("step_{}", steps.len() + 1),
                            step_type: "Formula".to_string(),
                            ..Step::default()
                        },
                    ));
                    steps.len() - 1
                }
            };
            let step = &mut steps[index].1;
            if let Some((type_name, props)) = word(rest) {
                if STEP_TYPES.contains(&type_name) && !type_name.ends_with(':') {
                    step.step_type = type_name.to_string();
                    apply_saga_props(step, saga_props(props));
                    continue;
                }
            }
            let Some((key, value)) = rest.split_once(':') else { continue };
            let key = key.trim();
            let value = value.trim();
            match key {
                "type" => {
                    let (type_name, result) = match value.find(" as:") {
                        Some(at) => (&value[..at], Some(value[at + 4..].trim())),
                        None => (value, None),
                    };
                    if STEP_TYPES.contains(&type_name.trim()) {
                        step.step_type = type_name.trim().to_string();
                    }
                    if let Some(result) = result.filter(|r| !r.is_empty()) {
                        step.result_name = result.to_string();
                    }
                }
                "as" => step.result_name = value.to_string(),
                "table" => {
                    if let Ok(parsed) = value.parse::<Json>() {
                        step.table = Some(parsed);
                    }
                }
                "in" => step.loop_id = Some(value.to_string()),
                _ if is_identifier(key) => step.set(key, value.to_string()),
                _ => {}
            }
        }
    }

    // A membership naming a loop that was never declared is dropped, keeping the
    // step; a loop no step joined is dropped too — neither is drawn or run.
    let declared: Vec<String> = loops.iter().map(|l| l.id.clone()).collect();
    for (_, step) in &mut steps {
        if step.loop_id.as_ref().is_some_and(|id| !declared.contains(id)) {
            step.loop_id = None;
        }
    }
    loops.retain(|l| steps.iter().any(|(_, s)| s.loop_id.as_deref() == Some(l.id.as_str())));

    document(name, kind, &entity, &event, saga, &conditions, &loops, &steps, &hooks)
}

fn object(entries: Vec<(&str, Json)>) -> Json {
    let mut value = Json::Object(Default::default());
    if let Json::Object(map) = &mut value {
        for (key, entry) in entries {
            map.insert(key.to_string(), entry);
        }
    }
    value
}

fn text(value: &str) -> Json {
    Json::String(value.to_string())
}

fn condition_json(id: String, condition: &Condition) -> Json {
    object(vec![
        ("id", Json::String(id)),
        ("field", text(&condition.field)),
        ("operator", text(&condition.operator)),
        ("value", text(&condition.value)),
    ])
}

#[allow(clippy::too_many_arguments)]
fn document(
    name: &str,
    kind: &str,
    entity: &str,
    event: &str,
    saga: Option<(&str, &str)>,
    conditions: &[Condition],
    loops: &[Loop],
    steps: &[(String, Step)],
    hooks: &[Hook],
) -> Json {
    let mut entries = vec![
        ("automation", text("1.0")),
        ("name", text(name)),
        ("kind", text(kind)),
        (
            "trigger",
            object(vec![("entity", text(entity)), ("event", text(event))]),
        ),
    ];
    if kind == "saga" {
        let (trigger, operation) = saga.unwrap_or(("automatic", "CREATE"));
        entries.push(("sagaTrigger", text(trigger)));
        entries.push(("sagaOperation", text(operation)));
    }
    entries.push((
        "conditions",
        Json::Array(
            conditions
                .iter()
                .enumerate()
                .map(|(index, c)| condition_json(format!("cond_{}", index + 1), c))
                .collect(),
        ),
    ));
    entries.push((
        "loops",
        Json::Array(
            loops
                .iter()
                .map(|l| {
                    object(vec![
                        ("id", text(&l.id)),
                        ("condition", condition_json(format!("{}_check", l.id), &l.condition)),
                        ("maxPasses", text(&l.max_passes)),
                    ])
                })
                .collect(),
        ),
    ));
    entries.push((
        "steps",
        Json::Array(
            steps
                .iter()
                .map(|(_, step)| {
                    let mut fields = vec![
                        ("id", text(&step.id)),
                        ("type", text(&step.step_type)),
                        ("resultName", text(&step.result_name)),
                        (
                            "props",
                            object(
                                step.props
                                    .iter()
                                    .map(|(k, v)| (k.as_str(), text(v)))
                                    .collect(),
                            ),
                        ),
                    ];
                    if let Some(loop_id) = &step.loop_id {
                        fields.push(("loopId", text(loop_id)));
                    }
                    if let Some(table) = &step.table {
                        fields.push(("table", table.clone()));
                    }
                    object(fields)
                })
                .collect(),
        ),
    ));
    entries.push((
        "hooks",
        Json::Array(
            hooks
                .iter()
                .enumerate()
                .map(|(index, h)| {
                    let mut fields = vec![
                        ("id", Json::String(format!("hook_{}", index + 1))),
                        ("event", text(&h.event)),
                        ("handler", text(&h.handler)),
                    ];
                    if let Some(field) = &h.field {
                        fields.push(("field", text(field)));
                    }
                    object(fields)
                })
                .collect(),
        ),
    ));
    entries.push(("status", text("draft")));
    object(entries)
}

#[cfg(test)]
mod tests {
    use super::*;

    fn get<'a>(value: &'a Json, path: &[&str]) -> &'a Json {
        path.iter().fold(value, |at, key| &at[*key])
    }

    #[test]
    fn converts_an_automation_with_a_condition_a_loop_and_its_steps() {
        let source = [
            "flowchart TD",
            "%%meta kind: workflow",
            "%%workflow name: Escalate critical deviations",
            "%%hook afterCreate on DeviationReport",
            "%%guard severity eq \"critical\"",
            "%%loop L1 while: status eq \"pending\" max: 20",
            "%%step s1 type: Decision as: tier",
            "%%step s1 ruleTable: Assay tier",
            "%%step s2 type: UpdateEntity",
            "%%step s2 field: status",
            "%%step s2 in: L1",
        ]
        .join("\n");
        let doc = automation_document(&source, "Record", "Escalate");
        assert_eq!(doc["automation"], "1.0");
        assert_eq!(doc["name"], "Escalate");
        assert_eq!(doc["kind"], "automation");
        assert_eq!(get(&doc, &["trigger", "entity"]), "DeviationReport");
        assert_eq!(get(&doc, &["trigger", "event"]), "created");
        assert_eq!(doc["conditions"][0]["value"], "critical");
        assert_eq!(doc["loops"][0]["maxPasses"], "20");
        assert_eq!(doc["loops"][0]["condition"]["value"], "pending");
        assert_eq!(doc["steps"][0]["type"], "Decision");
        assert_eq!(doc["steps"][0]["resultName"], "tier");
        assert_eq!(doc["steps"][0]["props"]["ruleTable"], "Assay tier");
        assert_eq!(doc["steps"][1]["loopId"], "L1");
        // The document is YAML: it parses as the screen's reader parses it.
        assert!(doc.to_string().starts_with('{'));
    }

    #[test]
    fn converts_a_saga_keeping_how_it_starts() {
        let source = [
            "%%workflow Handoff entity: Deal kind: saga trigger: rule operation: update",
            "flowchart TD",
            "%%step B Formula target: dueDays operation: multiply source: baseDays operand: 7",
            "%%step C CreateEntity entity: CAPA as: newCapaId fields: {\"title\":\"x y\"}",
            "%%step D UpdateEntity field: status source: dueDays targetSource: newCapaId",
        ]
        .join("\n");
        let doc = automation_document(&source, "Record", "Handoff");
        assert_eq!(doc["kind"], "saga");
        assert_eq!(doc["sagaTrigger"], "rule");
        assert_eq!(doc["sagaOperation"], "UPDATE");
        assert_eq!(get(&doc, &["trigger", "event"]), "updated");
        let formula = &doc["steps"][0];
        assert_eq!(formula["resultName"], "dueDays");
        assert_eq!(formula["props"]["left"], reference("baseDays"));
        assert_eq!(formula["props"]["right"], "7");
        assert_eq!(formula["props"]["operation"], "multiply");
        assert_eq!(doc["steps"][1]["props"]["values"], "{\"title\":\"x y\"}");
        assert_eq!(doc["steps"][2]["props"]["value"], reference("dueDays"));
        assert_eq!(doc["steps"][2]["props"]["target"], reference("newCapaId"));
    }

    #[test]
    fn converts_a_hook_workflow() {
        let source = "%%hook beforeCreate normalizeName on Account[field: name]\n\
                      %%hook afterCreate notifyOwner on Account";
        let doc = automation_document(source, "Record", "Account hooks");
        assert_eq!(doc["kind"], "hook");
        assert_eq!(get(&doc, &["trigger", "entity"]), "Account");
        assert_eq!(doc["hooks"][0]["handler"], "normalizeName");
        assert_eq!(doc["hooks"][0]["field"], "name");
        assert_eq!(doc["hooks"][1]["event"], "afterCreate");
    }

    #[test]
    fn skips_the_old_spelling_of_an_access_rule() {
        let doc = automation_document(
            "%%hook afterCreate on Order\n%%guard role:admin on Order.delete",
            "Record",
            "A",
        );
        assert_eq!(doc["conditions"].as_array().map(Vec::len), Some(0));
    }

    #[test]
    fn drops_a_loop_nothing_joins_and_a_membership_of_nothing() {
        let doc = automation_document(
            "%%loop L1 while: a eq 1 max: 3\n%%step s1 type: UpdateEntity\n%%step s1 in: L9",
            "Order",
            "A",
        );
        assert_eq!(doc["loops"].as_array().map(Vec::len), Some(0));
        assert!(doc["steps"][0].get("loopId").is_none());
    }
}
