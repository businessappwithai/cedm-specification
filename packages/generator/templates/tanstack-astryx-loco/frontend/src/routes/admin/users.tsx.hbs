import { createFileRoute, Link } from '@tanstack/react-router';
import { useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { useState } from 'react';
import {
  Users,
  ArrowLeft,
  Shield,
  Loader2,
  AlertCircle,
  Plus,
  Pencil,
  KeyRound,
  UserX,
  Trash2,
  Lock,
} from 'lucide-react';
import { apiClient } from '@/lib/api-client';
import { Button } from '@/components/ui/button';
import { Checkbox } from '@/components/ui/checkbox';
import { Input } from '@/components/ui/input';
import { Label } from '@/components/ui/label';
import { Switch } from '@/components/ui/switch';
import {
  Dialog,
  DialogContent,
  DialogDescription,
  DialogFooter,
  DialogHeader,
  DialogTitle,
} from '@/components/ui/dialog';
import { HStack, Heading, Text } from '@/components/ui/layout';
import { describeError, type AccountRole, type Role } from '@/lib/accounts';

/**
 * Accounts: who can sign in, what they hold, and whether they may.
 *
 * Reads and writes `/api/accounts`, which is master-role only — a caller
 * without it gets the refusal rendered rather than an empty table, so "you
 * cannot see this" is not mistaken for "there is nobody here".
 *
 * Deactivating or locking an account takes effect on its next request, not
 * when its token expires; the backend refuses the token as well as the
 * sign-in. Nobody can deactivate, lock or delete their own account here, and
 * the backend refuses any change that would leave no active administrator.
 */
export const Route = createFileRoute('/admin/users')({
  component: UsersPage,
});

interface Account {
  id: string;
  email: string;
  name: string;
  description?: string | null;
  isActive: boolean;
  isLocked: boolean;
  isMaster: boolean;
  hasLogin: boolean;
  loginDate?: string | null;
  roles: AccountRole[];
}

type Editing =
  | { kind: 'create' }
  | { kind: 'edit'; account: Account }
  | { kind: 'password'; account: Account }
  | { kind: 'delete'; account: Account }
  | null;

const ACCOUNTS_KEY = ['admin', 'accounts'];

function UsersPage() {
  const queryClient = useQueryClient();
  const [editing, setEditing] = useState<Editing>(null);
  const [notice, setNotice] = useState<string | null>(null);

  const accounts = useQuery<{ data: Account[] }>({
    queryKey: ACCOUNTS_KEY,
    queryFn: () => apiClient.get('/accounts'),
  });
  const roles = useQuery<{ data: Role[] }>({
    queryKey: ['admin', 'account-roles'],
    queryFn: () => apiClient.get('/accounts/roles'),
  });

  const refresh = () => {
    queryClient.invalidateQueries({ queryKey: ACCOUNTS_KEY });
    queryClient.invalidateQueries({ queryKey: ['admin', 'account-roles'] });
  };

  const deactivate = useMutation({
    mutationFn: (id: string) => apiClient.post(`/accounts/${id}/deactivate`),
    onSuccess: () => {
      setNotice(null);
      refresh();
    },
    onError: (error: unknown) => setNotice(describeError(error)),
  });

  const rows = accounts.data?.data ?? [];

  return (
    <div className="min-h-screen bg-background">
      <header className="sticky top-0 z-10 bg-card border-b border-border">
        <div className="container-swiss">
          <HStack align="center" gap={3} className="h-14">
            <Link to="/dashboard" className="text-muted-foreground hover:text-foreground">
              <ArrowLeft size={16} />
            </Link>
            <Users className="w-4 h-4 text-primary" />
            <Heading level={1} className="font-display">User Management</Heading>
            <div className="ml-auto">
              <Button size="sm" onClick={() => setEditing({ kind: 'create' })}>
                <Plus size={14} /> New account
              </Button>
            </div>
          </HStack>
        </div>
      </header>

      <main className="container-swiss py-8 space-y-4">
        {notice && (
          <div className="swiss-alert-error p-4 text-sm" role="alert">
            {notice}
          </div>
        )}
        {accounts.isLoading && (
          <div className="swiss-card p-12 text-center">
            <Loader2 className="w-8 h-8 mx-auto animate-spin text-primary" />
          </div>
        )}
        {accounts.error && (
          <div className="swiss-alert-error p-8 text-center">
            <AlertCircle className="w-8 h-8 mx-auto mb-2 text-destructive" />
            <p>{describeError(accounts.error)}</p>
          </div>
        )}
        {!accounts.isLoading && !accounts.error && (
          <div className="swiss-card overflow-hidden">
            <table className="w-full text-sm">
              <thead>
                <tr className="border-b border-border bg-muted/40">
                  <th className="text-left px-4 py-3 font-medium text-muted-foreground">Name</th>
                  <th className="text-left px-4 py-3 font-medium text-muted-foreground">Email</th>
                  <th className="text-left px-4 py-3 font-medium text-muted-foreground">Roles</th>
                  <th className="text-left px-4 py-3 font-medium text-muted-foreground">Status</th>
                  <th className="text-left px-4 py-3 font-medium text-muted-foreground">Last sign-in</th>
                  <th className="px-4 py-3" />
                </tr>
              </thead>
              <tbody>
                {rows.map((account) => (
                  <tr key={account.id} className="border-b border-border last:border-0 hover:bg-muted/20">
                    <td className="px-4 py-3 font-medium">{account.name}</td>
                    <td className="px-4 py-3 text-muted-foreground">{account.email}</td>
                    <td className="px-4 py-3">
                      {account.roles.length ? (
                        <HStack gap={1} wrap>
                          {account.roles.map((role) => (
                            <span
                              key={role.id}
                              className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-primary/10 text-primary text-xs font-medium"
                            >
                              <Shield size={12} />
                              {role.name}
                            </span>
                          ))}
                        </HStack>
                      ) : (
                        <Text color="secondary" size="xs">No roles</Text>
                      )}
                    </td>
                    <td className="px-4 py-3">
                      <StatusBadge account={account} />
                    </td>
                    <td className="px-4 py-3 text-muted-foreground text-xs">
                      {account.loginDate ? new Date(account.loginDate).toLocaleString() : 'Never'}
                    </td>
                    <td className="px-4 py-3">
                      <HStack gap={1} justify="end">
                        <Button
                          size="sm"
                          variant="ghost"
                          aria-label={`Edit ${account.email}`}
                          title="Edit"
                          onClick={() => setEditing({ kind: 'edit', account })}
                        >
                          <Pencil size={14} />
                        </Button>
                        <Button
                          size="sm"
                          variant="ghost"
                          aria-label={`Reset the password of ${account.email}`}
                          title={account.hasLogin ? 'Reset password' : 'Set a password'}
                          onClick={() => setEditing({ kind: 'password', account })}
                        >
                          <KeyRound size={14} />
                        </Button>
                        {account.isActive && (
                          <Button
                            size="sm"
                            variant="ghost"
                            aria-label={`Deactivate ${account.email}`}
                            title="Deactivate"
                            disabled={deactivate.isPending}
                            onClick={() => deactivate.mutate(account.id)}
                          >
                            <UserX size={14} />
                          </Button>
                        )}
                        <Button
                          size="sm"
                          variant="ghost"
                          aria-label={`Delete ${account.email}`}
                          title="Delete"
                          onClick={() => setEditing({ kind: 'delete', account })}
                        >
                          <Trash2 size={14} />
                        </Button>
                      </HStack>
                    </td>
                  </tr>
                ))}
                {rows.length === 0 && (
                  <tr>
                    <td colSpan={6} className="px-4 py-12 text-center text-muted-foreground">No users found</td>
                  </tr>
                )}
              </tbody>
            </table>
          </div>
        )}
      </main>

      {(editing?.kind === 'create' || editing?.kind === 'edit') && (
        <AccountDialog
          account={editing.kind === 'edit' ? editing.account : undefined}
          roles={roles.data?.data ?? []}
          onClose={() => setEditing(null)}
          onSaved={() => {
            setEditing(null);
            refresh();
          }}
        />
      )}
      {editing?.kind === 'password' && (
        <PasswordDialog
          account={editing.account}
          onClose={() => setEditing(null)}
          onSaved={() => {
            setEditing(null);
            refresh();
          }}
        />
      )}
      {editing?.kind === 'delete' && (
        <DeleteDialog
          account={editing.account}
          onClose={() => setEditing(null)}
          onDeleted={() => {
            setEditing(null);
            refresh();
          }}
        />
      )}
    </div>
  );
}

function StatusBadge({ account }: { account: Account }) {
  if (account.isLocked) {
    return (
      <span className="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-800">
        <Lock size={12} /> Locked
      </span>
    );
  }
  return (
    <span
      className={`inline-block px-2 py-0.5 rounded-full text-xs font-medium ${account.isActive ? 'bg-green-100 text-green-700' : 'bg-muted text-muted-foreground'}`}
    >
      {account.isActive ? 'Active' : 'Inactive'}
    </span>
  );
}

function AccountDialog({
  account,
  roles,
  onClose,
  onSaved,
}: {
  account?: Account;
  roles: Role[];
  onClose: () => void;
  onSaved: () => void;
}) {
  const isNew = !account;
  const [email, setEmail] = useState(account?.email ?? '');
  const [name, setName] = useState(account?.name ?? '');
  const [password, setPassword] = useState('');
  const [isActive, setIsActive] = useState(account?.isActive ?? true);
  const [isLocked, setIsLocked] = useState(account?.isLocked ?? false);
  const [selected, setSelected] = useState<string[]>(account?.roles.map((r) => r.id) ?? []);
  const [error, setError] = useState<string | null>(null);

  const save = useMutation({
    mutationFn: () =>
      isNew
        ? apiClient.post('/accounts', { email, name, password, roles: selected, isActive })
        : apiClient.put(`/accounts/${account.id}`, { email, name, roles: selected, isActive, isLocked }),
    onSuccess: onSaved,
    onError: (err: unknown) => setError(describeError(err)),
  });

  const toggle = (id: string, on: boolean) =>
    setSelected((current) => (on ? [...current, id] : current.filter((r) => r !== id)));

  return (
    <Dialog open onOpenChange={(next) => (next ? undefined : onClose())}>
      <DialogContent className="space-y-4">
        <DialogHeader>
          <DialogTitle>{isNew ? 'New account' : `Edit ${account.email}`}</DialogTitle>
          <DialogDescription>
            {isNew
              ? 'The account can sign in as soon as it is saved.'
              : 'Deactivating or locking takes effect on the account’s next request.'}
          </DialogDescription>
        </DialogHeader>

        <div className="space-y-3">
          <div className="space-y-1">
            <Label>Email</Label>
            <Input type="email" aria-label="Email" placeholder="Email" value={email} onChange={(e) => setEmail(e.target.value)} />
          </div>
          <div className="space-y-1">
            <Label>Name</Label>
            <Input aria-label="Name" placeholder="Name" value={name} onChange={(e) => setName(e.target.value)} />
          </div>
          {isNew && (
            <div className="space-y-1">
              <Label>Password</Label>
              <Input
                type="password"
                aria-label="Password"
                placeholder="At least 8 characters"
                autoComplete="new-password"
                value={password}
                onChange={(e) => setPassword(e.target.value)}
              />
            </div>
          )}
          <div className="space-y-1">
            <Label>Roles</Label>
            {roles.length === 0 && <Text color="secondary" size="xs">No roles defined yet.</Text>}
            {roles.map((role) => (
              <label key={role.id} className="flex items-center gap-2 text-sm">
                <Checkbox
                  aria-label={role.name}
                  checked={selected.includes(role.id)}
                  onCheckedChange={(on) => toggle(role.id, on)}
                />
                {role.name}
                {role.isMasterRole && <span className="text-xs text-primary">(master)</span>}
              </label>
            ))}
          </div>
          <label className="flex items-center gap-2 text-sm">
            <Switch aria-label="Active" checked={isActive} onCheckedChange={setIsActive} />
            Active
          </label>
          {!isNew && (
            <label className="flex items-center gap-2 text-sm">
              <Switch aria-label="Locked" checked={isLocked} onCheckedChange={setIsLocked} />
              Locked
            </label>
          )}
        </div>

        {error && <p className="text-sm text-destructive" role="alert">{error}</p>}

        <DialogFooter>
          <HStack gap={2} justify="end">
            <Button variant="outline" onClick={onClose}>Cancel</Button>
            <Button isLoading={save.isPending} onClick={() => save.mutate()}>
              {isNew ? 'Create' : 'Save'}
            </Button>
          </HStack>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}

function PasswordDialog({
  account,
  onClose,
  onSaved,
}: {
  account: Account;
  onClose: () => void;
  onSaved: () => void;
}) {
  const [password, setPassword] = useState('');
  const [error, setError] = useState<string | null>(null);
  const save = useMutation({
    mutationFn: () => apiClient.post(`/accounts/${account.id}/reset-password`, { password }),
    onSuccess: onSaved,
    onError: (err: unknown) => setError(describeError(err)),
  });

  return (
    <Dialog open onOpenChange={(next) => (next ? undefined : onClose())}>
      <DialogContent className="space-y-4">
        <DialogHeader>
          <DialogTitle>{account.hasLogin ? 'Reset password' : 'Set a password'}</DialogTitle>
          <DialogDescription>
            {account.email} will sign in with this password. Resetting it also unlocks the account.
          </DialogDescription>
        </DialogHeader>
        <Input
          type="password"
          aria-label="New password"
          placeholder="At least 8 characters"
          autoComplete="new-password"
          value={password}
          onChange={(e) => setPassword(e.target.value)}
        />
        {error && <p className="text-sm text-destructive" role="alert">{error}</p>}
        <DialogFooter>
          <HStack gap={2} justify="end">
            <Button variant="outline" onClick={onClose}>Cancel</Button>
            <Button isLoading={save.isPending} onClick={() => save.mutate()}>Set password</Button>
          </HStack>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}

function DeleteDialog({
  account,
  onClose,
  onDeleted,
}: {
  account: Account;
  onClose: () => void;
  onDeleted: () => void;
}) {
  const [error, setError] = useState<string | null>(null);
  const remove = useMutation({
    mutationFn: () => apiClient.delete(`/accounts/${account.id}`),
    onSuccess: onDeleted,
    onError: (err: unknown) => setError(describeError(err)),
  });

  return (
    <Dialog open onOpenChange={(next) => (next ? undefined : onClose())}>
      <DialogContent className="space-y-4">
        <DialogHeader>
          <DialogTitle>Delete {account.email}?</DialogTitle>
          <DialogDescription>
            The login and the user record are both removed. An account that records still point at
            cannot be deleted; deactivate it instead.
          </DialogDescription>
        </DialogHeader>
        {error && <p className="text-sm text-destructive" role="alert">{error}</p>}
        <DialogFooter>
          <HStack gap={2} justify="end">
            <Button variant="outline" onClick={onClose}>Cancel</Button>
            <Button variant="destructive" isLoading={remove.isPending} onClick={() => remove.mutate()}>
              Delete
            </Button>
          </HStack>
        </DialogFooter>
      </DialogContent>
    </Dialog>
  );
}
