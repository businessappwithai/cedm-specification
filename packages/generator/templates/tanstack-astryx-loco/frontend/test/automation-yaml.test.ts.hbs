/**
 * Automations are stored as YAML — {{project.name}}.
 * Generated by AppWithAI
 *
 * The automations screen writes each automation as its own YAML document and
 * reads it back when the screen opens. What is checked here is that the two
 * agree: an automation saved and reopened is the automation that was saved, a
 * document migration m0017 converted opens like any other, and a document that
 * is not an automation is refused by name rather than opened as an empty one.
 *
 * The entity is this application's own, from the model it was generated from.
 */

import { describe, expect, it } from 'vitest';
import { parse } from 'yaml';
import {
  type Automation,
  emptyAutomation,
  newCondition,
  newHook,
  newLoop,
  newStep,
} from '../src/lib/automation/model';
import {
  AUTOMATION_DOCUMENT_VERSION,
  AutomationDocumentError,
  automationFromYaml,
  automationToYaml,
  readStoredAutomation,
} from '../src/lib/automation/yaml';

const ENTITY = '{{#if entities.[0]}}{{entities.[0].name}}{{else}}Record{{/if}}';
const FIELD = '{{#if entities.[0]}}{{#each entities.[0].attributes}}{{#if @first}}{{this.name}}{{/if}}{{/each}}{{else}}id{{/if}}';

/** An automation using every part of the model: a condition, a loop, steps, a table. */
function fullAutomation(): Automation {
  const automation = emptyAutomation(ENTITY);
  const condition = { ...newCondition(), field: `${ENTITY.toLowerCase()}.${FIELD}`, operator: 'isNotEmpty' };
  const loop = { ...newLoop([]), maxPasses: '5' };
  loop.condition = { ...loop.condition, field: `${ENTITY.toLowerCase()}.${FIELD}`, operator: 'changed' };
  const decision = newStep('Decision');
  const update = { ...newStep('UpdateEntity'), loopId: loop.id };
  update.props = { ...update.props, entity: ENTITY, field: FIELD, value: 'reviewed' };
  return {
    ...automation,
    name: `Review ${ENTITY}`,
    description: `Marks a ${ENTITY} reviewed once ${FIELD} is set.`,
    trigger: { entity: ENTITY, event: 'updated' },
    conditions: [condition],
    loops: [loop],
    steps: [decision, update],
  };
}

/** What survives storage: everything but the screen's in-memory ids. */
function withoutIds(automation: Automation) {
  const { id: _id, updatedAt: _updatedAt, ...rest } = automation;
  return rest;
}

describe('automation YAML storage', () => {
  it('writes a versioned document that parses as YAML', () => {
    const document = parse(automationToYaml(fullAutomation()));
    expect(document.automation).toBe(AUTOMATION_DOCUMENT_VERSION);
    expect(document.kind).toBe('automation');
    expect(document.trigger).toEqual({ entity: ENTITY, event: 'updated' });
    expect(document.steps).toHaveLength(2);
    expect(document.loops[0].maxPasses).toBe('5');
  });

  it('reopens an automation as the one that was saved', () => {
    const saved = fullAutomation();
    const reopened = automationFromYaml(automationToYaml(saved));
    expect(withoutIds(reopened)).toEqual(withoutIds(saved));
  });

  it('writes the same bytes for the same automation', () => {
    const saved = fullAutomation();
    const once = automationToYaml(saved);
    expect(automationToYaml(automationFromYaml(once))).toBe(once);
  });

  it("keeps a hook workflow's handlers and a saga's start", () => {
    const hook = emptyAutomation(ENTITY, 'hook');
    hook.hooks = [{ ...newHook('customValidate'), handler: `validate${ENTITY}`, field: FIELD }];
    expect(automationFromYaml(automationToYaml(hook)).hooks).toEqual(hook.hooks);

    const saga = { ...emptyAutomation(ENTITY, 'saga'), sagaTrigger: 'automatic' as const, sagaOperation: 'UPDATE' as const };
    const reopened = automationFromYaml(automationToYaml(saga));
    expect(reopened.sagaTrigger).toBe('automatic');
    expect(reopened.sagaOperation).toBe('UPDATE');
  });

  it('opens a stored row under the name the row carries', () => {
    const saved = fullAutomation();
    const row = { id: 'stored', name: 'Renamed in the list', definition_yaml: automationToYaml(saved) };
    const reopened = readStoredAutomation(row);
    expect(reopened.name).toBe('Renamed in the list');
    expect(reopened.steps.map((s) => s.type)).toEqual(saved.steps.map((s) => s.type));
  });

  it('refuses a stored row that carries no document', () => {
    expect(() => readStoredAutomation({ id: 'stored', name: 'Empty', definition_yaml: null })).toThrow(
      AutomationDocumentError
    );
  });

  it('opens a document written as JSON, as migration m0017 writes the rows it converts', () => {
    const converted = JSON.stringify({
      automation: AUTOMATION_DOCUMENT_VERSION,
      name: 'Converted',
      kind: 'automation',
      trigger: { entity: ENTITY, event: 'created' },
      conditions: [{ id: 'cond_1', field: FIELD, operator: 'isNotEmpty', value: '' }],
      loops: [],
      steps: [{ id: 'step_1', type: 'UpdateEntity', resultName: '', props: { field: FIELD, value: 'x' } }],
      hooks: [],
      status: 'draft',
    });
    const reopened = automationFromYaml(converted);
    expect(reopened.trigger).toEqual({ entity: ENTITY, event: 'created' });
    expect(reopened.conditions[0]?.operator).toBe('isNotEmpty');
    expect(reopened.steps[0]?.props).toEqual({ field: FIELD, value: 'x' });
  });

  it.each([
    ['not YAML', 'kind: [automation', /is not YAML/],
    ['a list', '- automation', /is not a YAML mapping/],
    ['unversioned', `kind: automation\ntrigger:\n  entity: ${ENTITY}\n  event: created\n`, /no `automation:` version key/],
    ['a later version', `automation: "9.0"\nkind: automation\n`, /is version 9\.0/],
    ['an unknown kind', `automation: "1.0"\nkind: pipeline\n`, /`kind: pipeline`/],
    ['without an entity', `automation: "1.0"\nkind: automation\ntrigger:\n  event: created\n`, /needs `trigger\.entity`/],
    ['an unknown step', `automation: "1.0"\nkind: automation\ntrigger:\n  entity: ${ENTITY}\n  event: created\nsteps:\n  - type: Teleport\n`, /`steps\[0\]\.type: Teleport`/],
  ])('refuses a document that is %s', (_what, source, message) => {
    expect(() => automationFromYaml(source)).toThrow(AutomationDocumentError);
    expect(() => automationFromYaml(source)).toThrow(message);
  });
});
