{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://appwithai.dev/schema/cedm/1.0/cedm-model.schema.json",
  "title": "CEDM application model",
  "description": "An application written in CEDM: its entities in the CEDM entity shape (schema/cedm-entity.schema.yaml), imported from the domain library or declared here, and the application profile (specification/application-profile.yaml) — screens, access, hooks, executable rules, processes and reports. One document is one application. It is lowered into the model document every generator compiles (language/yaml/eml.schema.json), and the definitions it shares with that document are referenced from it rather than restated.",
  "type": "object",
  "additionalProperties": false,
  "required": ["cedm"],
  "properties": {
    "cedm": {
      "description": "Version of the CEDM application model this document is written in.",
      "const": "1.0"
    },
    "application": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/line" },
        "version": { "$ref": "#/$defs/line" },
        "description": {
          "description": "What the application is for, in one sentence.",
          "$ref": "#/$defs/line"
        },
        "namespace": { "$ref": "#/$defs/line" },
        "domain": {
          "description": "The catalog domain (domains/catalog.yaml) the application serves.",
          "$ref": "#/$defs/line"
        },
        "enumerationTables": {
          "description": "Give every enumeration a business table, maintained in its own window and read by the dropdowns (specification/enumeration-semantics.yaml).",
          "type": "boolean"
        }
      }
    },
    "imports": {
      "description": "Library entities (domain/entities) and application modules brought into the model. An imported entity also brings the entities its required relationships point at.",
      "type": "array",
      "items": { "$ref": "#/$defs/import" }
    },
    "enums": {
      "description": "Value lists shared by several attributes. A list one attribute uses is written on the attribute as `values`.",
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/enum" }
    },
    "entities": {
      "description": "Entities declared in this model, in the CEDM entity shape. One named like an imported entity refines it.",
      "type": "array",
      "items": { "$ref": "#/$defs/entity" }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "categories": {
          "description": "Dashboard groupings.",
          "type": "array",
          "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/category" }
        }
      }
    },
    "authorization": {
      "description": "Permissions, in specification/authorization.yaml's terms. Only grants compile: the generated application's rules are additive.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "permissions": { "type": "array", "items": { "$ref": "#/$defs/permission" } }
      }
    },
    "hooks": {
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/hook" }
    },
    "hookFlows": {
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/hookFlow" }
    },
    "triggers": {
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/trigger" }
    },
    "reports": {
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/report" }
    },
    "rules": {
      "description": "Executable business rules, compiled to GoRules JDM decision graphs. An entity invariant with `violatedWhen` compiles to one too.",
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/rule" }
    },
    "processes": {
      "description": "Multi-step processes run on a write (sagas), compiled to BPMN.",
      "type": "array",
      "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/saga" }
    }
  },
  "$defs": {
    "line": {
      "type": "string",
      "pattern": "^[^\\s](?:[^\\n\\r]*[^\\s])?$"
    },
    "prose": {
      "description": "Free text. Folded to one line where the application shows it.",
      "type": "string",
      "minLength": 1
    },
    "entityName": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]*$"
    },
    "attributeName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
    },
    "help": {
      "description": "Help as one sentence, or structured as specification/help-semantics.yaml describes (summary, businessMeaning, usage, relationshipContext, …).",
      "oneOf": [
        { "$ref": "#/$defs/prose" },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/helpValue" } }
      ]
    },
    "helpValue": {
      "oneOf": [
        { "type": "string" },
        { "type": "array", "items": { "type": "string" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/helpValue" } }
      ]
    },
    "cardinality": {
      "description": "CEDM cardinality (specification/vocabulary.yaml). `n..*` with n > 1 is accepted and enforced as 1..*.",
      "type": "string",
      "pattern": "^(0\\.\\.1|1|0\\.\\.\\*|[1-9][0-9]*\\.\\.\\*)$"
    },
    "import": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["entity"],
          "properties": {
            "entity": { "$ref": "#/$defs/entityName" },
            "include": {
              "description": "Keep only these attributes and relationships.",
              "type": "array",
              "items": { "$ref": "#/$defs/attributeName" }
            },
            "exclude": {
              "description": "Drop these attributes and relationships.",
              "type": "array",
              "items": { "$ref": "#/$defs/attributeName" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["module"],
          "properties": {
            "module": {
              "description": "An application module: `<name>.cedm.yaml` beside this model, or under the applications/ directory of the specification.",
              "type": "string",
              "pattern": "^[A-Za-z0-9_./-]+$"
            }
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key"],
      "properties": {
        "key": {
          "oneOf": [
            { "$ref": "#/$defs/attributeName" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/attributeName" } },
            { "type": "null" }
          ]
        },
        "type": { "type": "string" },
        "generated": { "type": "boolean" },
        "immutable": { "type": "boolean" }
      }
    },
    "attribute": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "type"],
      "patternProperties": {
        "^immutableAfter[A-Z][A-Za-z]*$": { "type": "boolean" }
      },
      "properties": {
        "name": { "$ref": "#/$defs/attributeName" },
        "narrowedBy": {
          "description": "Other relationships or reference attributes of this entity that narrow the choices of this one, most specific first: a city is narrowed by its stateProvince and then its country. The lookup offers only the rows that belong to the values the record holds, and a write naming any other is refused.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attributeName" }
        },
        "column": {
          "description": "The physical column, where it is not the snake_case of the name (or `id`, for the identity key).",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "type": {
          "description": "A CEDM vocabulary type (uuid, string, integer, decimal, boolean, date, datetime, money, enum, reference, object, currency_code, country_code, locale, timezone) or a model-language type token (text, email, string(255), …).",
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]*(?:\\([0-9,]+\\))?$"
        },
        "required": { "type": "boolean" },
        "unique": { "type": "boolean" },
        "immutable": { "type": "boolean" },
        "systemManaged": { "type": "boolean" },
        "maxLength": { "type": "integer", "minimum": 1 },
        "precision": { "type": "integer", "minimum": 1 },
        "scale": { "type": "integer", "minimum": 0 },
        "minimum": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/line" }] },
        "maximum": { "oneOf": [{ "type": "number" }, { "$ref": "#/$defs/line" }] },
        "default": {
          "description": "The value a new record starts with. A structured default (a money amount with its currency) is carried as JSON.",
          "oneOf": [
            { "type": "string" },
            { "type": "number" },
            { "type": "boolean" },
            { "type": "object" }
          ]
        },
        "values": {
          "description": "Inline value list: the column becomes a dropdown of these.",
          "type": "array",
          "minItems": 1,
          "items": { "oneOf": [{ "type": "string" }, { "type": "number" }] }
        },
        "enumName": {
          "description": "The name an inline value list is published under. Defaults to <Entity><Attribute>.",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "enum": {
          "description": "A shared value list from the model's `enums`.",
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "target": {
          "description": "For a reference: the entity it points at.",
          "$ref": "#/$defs/entityName"
        },
        "keyType": {
          "description": "For a reference: the type token of the stored key. Defaults to string.",
          "type": "string"
        },
        "help": { "$ref": "#/$defs/help" },
        "description": { "$ref": "#/$defs/prose" },
        "comment": { "$ref": "#/$defs/line" },
        "ui": { "$ref": "#/$defs/line" },
        "format": { "$ref": "#/$defs/line" }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "cardinality"],
      "properties": {
        "name": { "$ref": "#/$defs/attributeName" },
        "target": { "$ref": "#/$defs/entityName" },
        "cardinality": { "$ref": "#/$defs/cardinality" },
        "inverseCardinality": {
          "description": "How many source records relate to one target. Defaults to 1 for a to-many relationship; a to-one relationship that states none is the many side of a one-to-many.",
          "enum": ["0..1", "1", "0..*", "1..*"]
        },
        "ownership": { "enum": ["aggregate", "reference"] },
        "inverse": {
          "description": "The relationship's name on the target, when both sides declare it.",
          "$ref": "#/$defs/attributeName"
        },
        "label": {
          "description": "The relationship's name in the generated application. Defaults to the snake_case of `name`.",
          "type": "string",
          "pattern": "^[^\\s\"](?:[^\"\\n\\r]*[^\\s\"])?$"
        },
        "narrowedBy": {
          "description": "Other relationships or reference attributes of this entity that narrow the choices of this one, most specific first: a city is narrowed by its stateProvince and then its country. The lookup offers only the rows that belong to the values the record holds, and a write naming any other is refused.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attributeName" }
        },
        "foreignKey": {
          "description": "The attribute holding a to-one relationship's key (on the target, for a to-many one). Found by name when omitted and created when none exists; false says the key is kept elsewhere.",
          "oneOf": [{ "$ref": "#/$defs/attributeName" }, { "const": false }]
        },
        "help": { "$ref": "#/$defs/help" },
        "description": { "$ref": "#/$defs/prose" },
        "condition": { "type": "string" }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "action": {
          "description": "The command that makes the move; becomes the transition's trigger, which `authorization` may grant.",
          "type": "string",
          "pattern": "^[A-Za-z_][\\w-]*$"
        },
        "guard": { "type": "string" },
        "authorization": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "sideEffects": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "auditEvent": { "type": "string" }
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states"],
      "properties": {
        "name": { "type": "string", "pattern": "^\\S+$" },
        "title": { "$ref": "#/$defs/line" },
        "attribute": { "$ref": "#/$defs/attributeName" },
        "states": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "initial": { "type": "string" },
        "terminal": { "type": "array", "items": { "type": "string" } },
        "transitions": { "type": "array", "items": { "$ref": "#/$defs/transition" } }
      }
    },
    "workflow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "when", "steps"],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]*$" },
        "title": { "$ref": "#/$defs/line" },
        "description": { "$ref": "#/$defs/prose" },
        "when": {
          "description": "A condition over the record, in the rules engine's expression language over physical columns. On an update `_previous_<column>` is the column as it was.",
          "$ref": "#/$defs/line"
        },
        "event": { "type": "string", "pattern": "^\\S+$" },
        "message": { "$ref": "#/$defs/line" },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "type"],
            "properties": {
              "id": { "type": "string", "pattern": "^\\S+$" },
              "type": { "enum": ["CreateEntity", "UpdateEntity", "DeleteEntity", "Decision", "Formula", "REST", "Agent"] },
              "label": { "$ref": "#/$defs/line" },
              "properties": { "type": "object" }
            }
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule"],
      "properties": {
        "id": { "type": "string", "pattern": "^\\S+$" },
        "rule": { "$ref": "#/$defs/prose" },
        "severity": { "enum": ["error", "warning", "info"] },
        "enforcement": {
          "oneOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }]
        },
        "message": { "$ref": "#/$defs/line" },
        "appliesWhen": { "type": "string" },
        "violatedWhen": {
          "description": "The condition under which the invariant is broken, in the rules engine's expression language over physical columns. An invariant with one compiles to a validation rule.",
          "$ref": "#/$defs/line"
        },
        "events": {
          "description": "Lifecycle events the compiled rule runs on. Defaults to beforeCreate and beforeUpdate.",
          "type": "array",
          "items": { "$ref": "https://appwithai.dev/schema/eml/1.0/eml.schema.json#/$defs/hookEvent" }
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": ["columns"],
      "properties": {
        "columns": {
          "description": "Attribute names, or physical columns.",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/attributeName" }
        },
        "unique": { "type": "boolean" }
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "$ref": "#/$defs/entityName" },
        "namespace": { "type": "string" },
        "kind": { "type": "string" },
        "description": { "$ref": "#/$defs/prose" },
        "extends": { "$ref": "#/$defs/entityName" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "identity": { "$ref": "#/$defs/identity" },
        "attributes": { "type": "array", "items": { "$ref": "#/$defs/attribute" } },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "lifecycle": {
          "oneOf": [
            { "$ref": "#/$defs/lifecycle" },
            { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lifecycle" } }
          ]
        },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
        "referenceData": {
          "description": "A file under domain/ holding the rows this entity ships with; the library inlines it as `data`.",
          "type": "string"
        },
        "data": {
          "description": "Rows the entity ships with, keyed by attribute or relationship name. A reference holds the natural key of the row it points at.",
          "type": "object",
          "additionalProperties": false,
          "required": ["key", "rows"],
          "properties": {
            "key": { "type": "string" },
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": { "type": ["string", "number", "boolean", "null"] }
              }
            }
          }
        },
        "workflows": {
          "description": "Workflows the entity starts when a record meets a condition. Each lowers to a saga and a rule that triggers it.",
          "type": "array",
          "items": { "$ref": "#/$defs/workflow" }
        },
        "audit": { "type": "object" },
        "help": { "$ref": "#/$defs/help" },
        "ui": {
          "description": "Application profile: how the entity is presented.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "icon": {
              "description": "A lucide icon id, e.g. `flask-conical`.",
              "type": "string",
              "pattern": "^[\\w.-]+$"
            },
            "label": { "$ref": "#/$defs/line" }
          }
        },
        "persistence": {
          "description": "Application profile: how the entity is stored.",
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "concurrency": {
              "description": "How two people editing one record are reconciled: `optimistic` (the default) refuses a save made against a version someone else has replaced; `last-write-wins` accepts a save that names no version. Lowered to the entity's `concurrency`.",
              "enum": ["optimistic", "last-write-wins"]
            },
            "prefix": { "enum": ["bus", "sys"] },
            "softDelete": { "type": "boolean" },
            "audited": { "type": "boolean" },
            "indexes": { "type": "array", "items": { "$ref": "#/$defs/index" } }
          }
        },
        "aggregateRoot": {
          "description": "The aggregate root this entity is a line item of, where no `ownership: aggregate` relationship on the root says so.",
          "$ref": "#/$defs/entityName"
        }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource", "action", "subject"],
      "properties": {
        "resource": { "$ref": "#/$defs/entityName" },
        "action": {
          "description": "A CRUD operation (or alias), `*`, or a lifecycle action.",
          "type": "string",
          "pattern": "^\\S+$"
        },
        "subject": {
          "description": "The role, or roles, granted the action.",
          "oneOf": [
            { "type": "string", "pattern": "^\\S+$" },
            { "type": "array", "minItems": 1, "items": { "type": "string", "pattern": "^\\S+$" } }
          ]
        },
        "effect": { "enum": ["allow", "deny"] },
        "scope": { "type": "string" }
      }
    }
  }
}
