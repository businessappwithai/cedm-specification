//! `cargo loco task seed_rules` — install the model's `%%rule` decision graphs.
//!
//! A `%%rule` section is a decision flowchart. The generator compiles it to a
//! GoRules JDM document and writes it to `seed/rules.sql`; this applies it to
//! `sys_rule_definitions`, which is the table `bus::load_entity_jdms` reads on
//! every business write.
//!
//! Without this the table stayed empty: the controller read it, the admin
//! editor edited it, and nothing ever put a row in it — so a rule drawn in the
//! design phase reached the generated application and did nothing.
//!
//! **Seeding installs; it does not overwrite.** Each statement conflicts on
//! `(entity_name, operation, rule_name)` and updates only when the session
//! setting `appwithai.rules_overwrite` is `'on'`, which this task does not set.
//! Re-running is therefore safe against a database an administrator has been
//! editing. `POST /api/rules/migrate` sets it and applies the same file, which
//! is how a changed flowchart reaches a database that already has the old one.

use loco_rs::prelude::*;
use loco_rs::task::Vars;
use sea_orm::ConnectionTrait;

/// The generated rules. Regenerate rather than edit.
///
/// `pub` because `controllers::rules::migrate` applies the same file with the
/// overwrite setting on. Embedding it twice would put every JDM document in the
/// binary twice, and give the two copies somewhere to drift apart.
pub const RULES_SQL: &str = include_str!("../../seed/rules.sql");

pub struct SeedRules;

#[async_trait]
impl Task for SeedRules {
    fn task(&self) -> TaskInfo {
        TaskInfo {
            name: "seed_rules".to_string(),
            detail: "Install the business rules declared by %%rule".to_string(),
        }
    }

    async fn run(&self, ctx: &AppContext, _vars: &Vars) -> Result<()> {
        // One call for the whole file, so a failure part-way leaves the table
        // untouched rather than half seeded.
        ctx.db.execute_unprepared(RULES_SQL).await?;

        let installed: Option<(i64,)> =
            sqlx::query_as("SELECT COUNT(*) FROM sys_rule_definitions WHERE is_active")
                .fetch_optional(ctx.db.get_postgres_connection_pool())
                .await
                .map_err(|err| Error::Message(format!("counting rules: {err}")))?;

        println!(
            "✓ Business rules installed ({} active rule(s) in sys_rule_definitions)",
            installed.map_or(0, |row| row.0)
        );
        Ok(())
    }
}
