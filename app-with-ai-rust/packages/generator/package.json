{
  "name": "@appwithai/generator",
  "version": "5.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./graph": "./dist/graph/index.js",
    "./pipeline": "./dist/pipeline/index.js",
    "./rules": "./dist/rules/index.js",
    "./model-yaml": "./dist/model-yaml/index.js"
  },
  "types": "./dist/index.d.ts",
  "bin": {
    "appwithai": "./dist/cli/generate.js",
    "appwithai-generate": "./dist/cli/generate.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "dependencies": {
    "@appwithai/core": "workspace:*",
    "ajv": "^8.17.1",
    "commander": "^11.1.0",
    "handlebars": "^4.7.8",
    "node-ssh": "^13.2.1",
    "prettier": "^3.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.3.0",
    "vitest": "^1.1.3",
    "@vitest/coverage-v8": "^1.1.3"
  },
  "scripts": {
    "build": "bun build src/index.ts src/cli/generate.ts src/graph/index.ts src/pipeline/index.ts src/rules/index.ts src/model-yaml/index.ts --outdir dist --target node --format esm --external @appwithai/core --external handlebars --external commander --external prettier",
    "generate": "bun dist/cli/generate.js generate",
    "dev": "bun run build && bun run generate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts"
  }
}
