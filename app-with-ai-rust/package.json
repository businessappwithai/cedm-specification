{
  "name": "appwithai",
  "version": "5.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "bun --filter @appwithai/web dev",
    "dev:mastra": "bun --filter @appwithai/ai dev",
    "build": "bun run lint && bun run build:core && bun run build:generator && bun run build:ai && bun run build:web",
    "build:core": "bun --filter @appwithai/core build",
    "build:generator": "bun --filter @appwithai/generator build",
    "build:ai": "bun --filter @appwithai/ai build",
    "build:web": "bun --filter @appwithai/web build",
    "start": "bun --filter @appwithai/web start",
    "start:mastra": "bun --filter @appwithai/ai start",
    "lint": "biome lint .",
    "lint:fix": "biome check --write .",
    "type-check": "tsc --noEmit",
    "type-check:language": "tsc -p tsconfig.language.json",
    "parity": "./scripts/parity-check.sh",
    "build:language-tools": "bun scripts/build-language-tools.ts",
    "test:language-tools": "bun scripts/build-language-tools.ts --check",
    "clean": "rm -rf node_modules packages/*/node_modules packages/*/dist",
    "convert": "bun --filter @appwithai/ai convert",
    "generate": "INIT_CWD=$PWD bun --filter @appwithai/generator generate --",
    "generate:tanstack": "INIT_CWD=$PWD bun --filter @appwithai/generator generate -- --stack tanstack-astryx-loco",
    "eml": "bun language/cli/eml.ts",
    "test": "bun --filter @appwithai/web test",
    "test:watch": "bun --filter @appwithai/web test:watch",
    "test:generator": "bun --filter @appwithai/generator test",
    "test:e2e:server": "./scripts/tests/run-e2e-with-server.sh",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "test:playwright:debug": "playwright test --debug",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "setup:gstack": "git clone --single-branch --depth 1 https://github.com/garrytan/gstack.git ~/.claude/skills/gstack && cd ~/.claude/skills/gstack && ./setup",
    "seed:admin": "bun scripts/seed-admin.ts",
    "test:e2e:generated": "bun --filter @appwithai/generator test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@gorules/zen-engine-darwin-arm64": "0.54.0",
    "@playwright/test": "^1.62.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.16.0",
    "kysely": "^0.29.4",
    "playwright": "^1.62.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "bun": ">=1.3.14"
  },
  "preferredRuntime": "bun",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@copilotkit/react-core": "^1.64.1",
    "@copilotkit/react-ui": "^1.64.1",
    "@copilotkit/runtime": "^1.64.1",
    "@e2b/code-interpreter": "^2.7.0",
    "@mastra/client-js": "^1.35.0",
    "@mastra/core": "^1.54.0",
    "@mastra/fastembed": "^1.2.0",
    "@mastra/libsql": "^1.18.0",
    "@mastra/loggers": "^1.2.0",
    "@mastra/memory": "^1.24.0",
    "@mermaid-js/parser": "^1.2.0",
    "@tanstack/start": "^1.120.20",
    "autoprefixer": "^10.5.0",
    "critters": "^0.0.25",
    "openai": "^7.1.0"
  }
}
