# Generated
generated/
output/
test-output/
*.generated.*
.gstack/
.playwright-mcp/

# EML checker output. Written next to the model on every generator run and
# stamped with the time it ran, so tracking it means a one-line timestamp diff
# after every single generation — noise that says nothing about the model.

# Rust build output (crates/appwithai-gen)
target/

# A per-developer profile for a local model endpoint. Personal tooling.
.openclaude-profile.json

# Local runtime pid file
.appwithai-web.pid
language.zip
__pycache__/

# The repository copies (docs/architecture/yaml-only-repository-consolidation.md)
# are tracked exactly as their own repositories track them: none of the rules
# above applies inside them, and each copy's own .gitignore does.
!/app-with-ai-rust/**
!/app-and-report-with-ai-rust/**
!/enterprise-reporting-rust/**
!/businessappwithairust/**

# TypeScript incremental build state
*.tsbuildinfo
