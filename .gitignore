# Dependencies
node_modules/
.pnp
.pnp.js

# Testing
coverage/
*.test.js
*.test.ts
*.spec.js
*.spec.ts

# Allow test files inside source packages and generated-projects
!packages/yamltecture/test/*.test.ts
!packages/**/__tests__/*.test.ts
!packages/**/__tests__/*.spec.ts
!tools/__tests__/*.test.ts
!generated-projects/**/*.test.ts
!generated-projects/**/*.spec.ts
# The chat's own suites: unit, security and end to end. The rule above kept
# them out of every commit while they ran and passed locally.
!chat-deepseek/tests/**/*.test.ts

# Generated projects runtime artifacts
packages/web/generated-projects/
packages/generator/generated-projects/
generated-projects/

# Production
dist/
build/
.next/
out/

