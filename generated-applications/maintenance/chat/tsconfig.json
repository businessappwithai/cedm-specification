{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "isolatedModules": true,
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": [
    "gateway/**/*.ts",
    "plugins/**/*.js",
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "tests/.probe.ts",
    "tests/.rpc-probe.ts",
    "plugins/business-nodes/client.js"
  ]
}
