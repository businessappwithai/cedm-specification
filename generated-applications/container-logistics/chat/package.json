{
  "name": "@appwithai/chat-deepseek",
  "version": "0.1.0",
  "private": true,
  "description": "The business chat every generated application ships with: a DeepSeek Harness composition limited to the application's own tools, behind a gateway that signs one person into the chat, the application and its reporting platform.",
  "type": "module",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.19.0"
  },
  "scripts": {
    "start": "bun gateway/server.ts",
    "type-check": "tsc --noEmit -p tsconfig.json",
    "test": "bun test tests/unit",
    "test:composition": "bun tests/composition/check-composition.ts",
    "load": "bun tests/load/host-memory.ts"
  },
  "dependencies": {
    "@appwithai/chat-business-nodes": "workspace:*",
    "@appwithai/chat-business-tools": "workspace:*",
    "@deepseek-ai/dsh": "0.2.0-rc.2",
    "better-auth": "1.5.6",
    "kysely": "0.28.11",
    "pg": "8.17.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/pg": "8.16.0",
    "playwright": "1.62.0",
    "typescript": "5.9.3"
  },
  "workspaces": [
    "plugins/*"
  ]
}
