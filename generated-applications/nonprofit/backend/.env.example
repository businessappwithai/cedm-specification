# nonprofit — backend environment.
#
# Copy to `.env` and edit. Every variable here is read by `config/*.yaml`
# through Tera's `get_env(...)`, so the defaults shown are the ones the app
# falls back to when the variable is unset — nothing here is required to boot a
# development instance.
#
#   cp .env.example .env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Loco derives nothing from the crate name at run time: this URL is the whole
# answer, and `cargo loco db migrate` fails against a database that does not
# exist yet. Create it first with `createdb nonprofit_development`.
DATABASE_URL=postgres://postgres@localhost:5432/nonprofit_development

DB_CONNECT_TIMEOUT=500
DB_IDLE_TIMEOUT=500
DB_MIN_CONNECTIONS=1
DB_MAX_CONNECTIONS=10

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HOST=localhost
# The frontend's origin. A mismatch here is the usual cause of a browser that
# loads the app but gets a CORS failure on every API call.
CORS_ORIGIN=http://localhost:3001

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Base64, and shared with nothing else. The committed default is a development
# placeholder — replace it before this reaches an environment that matters:
#   openssl rand -base64 32
JWT_SECRET=ZGV2LW9ubHktc2VjcmV0LXJlcGxhY2UtbWUtaW4tcHJvZA==

# Seeded by `cargo loco db seed` (the `ensure_admin` task) and promoted to
# administrator. These are the values `ensure_admin` falls back to, so they are
# what you sign in with on a fresh database. Re-running the task with different
# values updates the account in place — that is the intended password reset.
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# ElectricSQL sync service. Unset is the supported case: the frontend's sys_
# hooks fall back to plain HTTP and never boot PGlite.
# ELECTRIC_URL=http://localhost:3100

# Background queue. Defaults to the async in-process worker, which needs no
# separate database.
# QUEUE_DATABASE_URL=

# Natural-language querying (POST /api/ai/query). Unset is the supported case:
# the route stays mounted and answers 503, so nothing else changes. Set both a
# URL and a model to turn it on — any OpenAI-compatible /chat/completions
# endpoint works, local or hosted.
#
# The model is never asked for SQL. It returns a query plan that is validated
# against the Application Dictionary and run through the same path
# /api/bus/{entity} uses, so the feature cannot read anything the signed-in
# account could not already read over REST.
# LOCAL_AI_BASE_URL=http://localhost:8000/v1
# LOCAL_AI_MODEL=qwen3.6:27b-mlx
# LOCAL_AI_API_KEY=local

# Rate limiting. Both budgets are per caller per minute, and a caller is the
# subject of a verified session token — not an address, because the users of
# this application arrive through one proxy and would otherwise share a single
# budget between them. An anonymous caller is counted by address, since there
# is nothing else to count. 0 switches a budget off.
#
# The credential budget covers /api/auth/{login,register,change-password}. It
# is a floor against password guessing rather than a substitute for per-account
# lockout, which this application does not have.
# RATE_LIMIT_MAX_PER_MINUTE=300
# RATE_LIMIT_AUTH_MAX_PER_MINUTE=30

# Whether X-Forwarded-For may be believed when counting an anonymous caller.
# Off is the security-relevant default: a client that can set its own forwarded
# header hands itself a fresh bucket per request, which turns the sign-in limit
# into decoration. Set it only when a proxy you control sits directly in front
# of this application and rewrites the header itself.
# TRUST_PROXY=1
